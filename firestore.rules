rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /cms_content/{document=**} {
      allow read, write: if true;
    }
    match /cms_articles/{document=**} {
      allow read, write: if true;
    }
    match /media_uploads/{document=**} {
      allow read, write: if true;
    }
    match /submissions/{submissionId} {
      allow create: if request.resource.data.keys().hasAll(['name', 'website', 'email', 'phone', 'focus', 'createdAt'])
                    && request.resource.data.keys().hasOnly(['name', 'website', 'email', 'phone', 'focus', 'createdAt'])
                    && request.resource.data.name is string && request.resource.data.name.size() <= 200
                    && request.resource.data.website is string && request.resource.data.website.size() <= 200
                    && request.resource.data.email is string && request.resource.data.email.size() <= 200
                    && request.resource.data.phone is string && request.resource.data.phone.size() <= 50
                    && request.resource.data.focus is string && request.resource.data.focus.size() <= 100
                    && request.resource.data.createdAt == request.time;
      allow read: if true;
      allow update, delete: if false;
    }
    match /admin_users/{userId} {
      allow read, write: if true;
    }
  }
}
