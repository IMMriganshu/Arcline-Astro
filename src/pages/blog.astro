---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionLabel from "../components/SectionLabel.astro";
import BlogSection from "../components/BlogSection.astro";
import ProjectCTA from "../components/ProjectCTA.astro";
---

<BaseLayout
  title="Journal & Perspectives — Arcline Architecture"
  description="Critical essays, research, and reflections on architecture, biophilic design, and urban density."
>
  <div class="pt-32 pb-4 max-w-[1440px] mx-auto px-4 sm:px-8 lg:px-12">
    <div class="mb-4">
      <SectionLabel text="ARCHITECTURAL ESSAYS" />
    </div>

    <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight text-[#030303] mb-6">
      Studio Perspectives & Architecture Insights
    </h1>

    <p class="text-lg text-neutral-600 max-w-2xl leading-relaxed">
      Thought leadership on spatial innovation, passive house standards, and material circularity.
    </p>
  </div>

  <BlogSection />
  <ProjectCTA />
</BaseLayout>
