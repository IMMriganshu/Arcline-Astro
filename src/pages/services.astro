---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionLabel from "../components/SectionLabel.astro";
import Button from "../components/Button.astro";
import ProjectCTA from "../components/ProjectCTA.astro";
import { getServices, getServicesHeroContent } from "../lib/cms";

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=31536000, stale-while-revalidate=86400');

const pageTitle = "Marketing Services for Plastic & Cosmetic Surgeons | seelutions";
const pageDescription = "AI search visibility, local SEO and Google Maps, web design, and Google Ads for board-certified plastic and facial cosmetic surgeons.";

const servicesHero = await getServicesHeroContent();
const services = await getServices();

const thumbnailImage = servicesHero.image || "/assets/aistudio/Owner_Video_Thumbnail_b026f920.jpg";
const videoSource = servicesHero.videoUrl || "/videos/seelutions_Video_Final.mp4";

// Map CMS services to include the correct link text for this page
const coreServices = services.map(srv => {
  let linkText = "Learn about AI search →";
  if (srv.number === "02") linkText = "Learn about Local SEO →";
  if (srv.number === "03") linkText = "Learn about Web Design →";
  if (srv.number === "04") linkText = "Learn about Google Ads →";
  
  // Map internal slugs if they don't exist
  let href = srv.href || "/services/";
  if (srv.number === "01") href = "/services/ai-search-overviews/";
  if (srv.number === "02") href = "/services/local-seo-google-maps/";
  if (srv.number === "03") href = "/services/web-design-conversion-optimization/";
  if (srv.number === "04") href = "/services/google-ads-paid-search/";

  return {
    ...srv,
    linkText,
    href
  };
});
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
>
  <!-- Primary Page Header & Hero Section with Video -->
  <section class="pt-32 pb-16 md:pt-40 md:pb-24 relative overflow-hidden bg-white">
    <div class="max-w-[1440px] mx-auto px-4 sm:px-8 lg:px-12">
      <div class="mb-4" data-animate="fade-up-sm">
        <SectionLabel text="SPECIALIZED SEARCH & GROWTH SERVICES" />
      </div>

      <!-- Two-Column Split Layout Above the Fold -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
        
        <!-- Column 1 (Left): Heading, Intro Copy, CTA Buttons -->
        <div class="lg:col-span-7 flex flex-col justify-center">
          <h1 data-animate="fade-up" class="text-3xl sm:text-4xl md:text-5xl lg:text-[3.25rem] font-bold tracking-tight text-[#030303] leading-[1.12] mb-6 font-urbanist">
            Digital Growth & Search Services for Plastic & Cosmetic Surgeons
          </h1>
          
          <p data-animate="fade-up-sm" data-animate-delay="1" class="text-lg sm:text-xl font-medium text-neutral-800 leading-relaxed mb-8 max-w-2xl">
            For more than a decade, we have specialized in marketing for board-certified plastic and facial cosmetic surgeons, helping them earn lasting visibility on Google, Google Maps, and AI search instead of paying for every click.
          </p>

          <div data-animate="fade-up-sm" data-animate-delay="2" class="flex flex-wrap items-center gap-4">
            <Button href="https://audit.seelutions.com/" variant="black" showIcon={true} iconType="arrow-right">
              Get Your Free Practice Visibility Audit
            </Button>
            <Button href="#services" variant="outline" showIcon={false}>
              See Our 4 Services ↓
            </Button>
          </div>
        </div>

        <!-- Column 2 (Right): Embedded Testimonial MP4 Video -->
        <div class="lg:col-span-5 flex flex-col" data-animate="scale-in">
          <div class="relative overflow-hidden rounded-2xl md:rounded-3xl shadow-xl border border-neutral-200/90 w-full bg-neutral-950 flex flex-col justify-center min-h-[380px] sm:min-h-[420px] h-full group">
            
            <!-- Video Element (Vertical Portrait Testimonial) -->
            <video
              id="services-founder-video"
              playsinline
              controls
              preload="metadata"
              poster={thumbnailImage}
              class="w-full h-full object-contain bg-black rounded-2xl md:rounded-3xl"
              aria-label="Dr. Ryan Diepenbrock testimonial video"
            >
              <source src="/videos/Dr Diepenbrock Testimonial Video.mov" type="video/quicktime" />
              Your browser does not support playing this video.
            </video>

            <!-- Custom Static Thumbnail & Click-to-Play Overlay -->
            <button
              id="services-video-overlay"
              type="button"
              class="absolute inset-0 z-30 w-full h-full text-left p-0 border-0 cursor-pointer overflow-hidden rounded-2xl md:rounded-3xl transition-all duration-300 focus:outline-none group/thumb"
              aria-label="Click to play Dr. Ryan Diepenbrock testimonial video"
            >
              <img
                src={thumbnailImage}
                alt="Dr. Ryan Diepenbrock on 10 years with seelutions"
                class="w-full h-full object-cover object-center transition-transform duration-700 ease-out group-hover/thumb:scale-102"
                loading="eager"
              />

              <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/25 to-black/30 pointer-events-none"></div>

              <!-- Prominent Centered Play Button -->
              <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
                <div class="relative flex items-center justify-center">
                  <div class="absolute w-20 h-20 rounded-full bg-white/30 animate-ping"></div>
                  <div class="relative w-16 h-16 sm:w-18 sm:h-18 rounded-full bg-white/90 shadow-2xl flex items-center justify-center text-[#051329] transform transition-transform duration-300 ease-out group-hover/thumb:scale-110 border-2 border-white/80">
                    <svg class="w-7 h-7 sm:w-8 sm:h-8 fill-current translate-x-0.5" viewBox="0 0 24 24">
                      <polygon points="6 3 20 12 6 21 6 3"></polygon>
                    </svg>
                  </div>
                </div>
              </div>

              <!-- Bottom Single Caption Box -->
              <div class="absolute bottom-4 left-4 right-4 pointer-events-none">
                <div class="p-3.5 rounded-xl bg-black/80 backdrop-blur-md border border-white/15 text-white shadow-xl text-center">
                  <p class="text-xs sm:text-sm font-semibold text-white tracking-tight">
                    Dr. Ryan Diepenbrock on 10 years with seelutions
                  </p>
                </div>
              </div>
            </button>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Core Services Section: 4-Card Grid -->
  <section id="services" class="py-16 md:py-24 bg-neutral-50 border-t border-b border-neutral-200">
    <div class="max-w-[1440px] mx-auto px-4 sm:px-8 lg:px-12">
      
      <div class="text-center max-w-3xl mx-auto mb-14">
        <div class="mb-3 inline-block" data-animate="fade-up-sm">
          <SectionLabel text="OUR SERVICES" />
        </div>
        <h2 data-animate="fade-up" class="text-3xl sm:text-4xl md:text-5xl font-bold text-[#030303] tracking-tight font-urbanist">
          Four services built for surgical practices
        </h2>
      </div>

      <!-- 4-Card Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8 items-stretch">
        {coreServices.map((srv) => (
          <div data-animate="fade-up" class="bg-white border border-neutral-200/90 rounded-2xl md:rounded-3xl p-6 sm:p-8 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between group hover:-translate-y-1">
            <div>
              <div class="flex items-center justify-between mb-6">
                <span class="text-xs font-bold tracking-widest px-3 py-1 rounded-full bg-[#051329] text-[#C5A880]">
                  {srv.number}
                </span>
                <span class="w-8 h-8 rounded-full bg-neutral-100 group-hover:bg-[#C5A880] group-hover:text-[#051329] transition-colors flex items-center justify-center text-xs font-bold">
                  ↗
                </span>
              </div>

              <h3 class="text-xl sm:text-2xl font-bold text-[#030303] tracking-tight mb-3 font-urbanist group-hover:text-[#C5A880] transition-colors">
                {srv.title}
              </h3>

              <p class="text-neutral-600 text-sm sm:text-base leading-relaxed mb-6">
                {srv.description}
              </p>
            </div>

            <div class="pt-4 border-t border-neutral-100">
              <a
                href={srv.href}
                class="inline-flex items-center gap-2 text-sm font-bold text-[#030303] hover:text-[#C5A880] transition-colors"
              >
                <span>{srv.linkText}</span>
              </a>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- Bottom Practice Visibility Audit CTA Section -->
  <ProjectCTA />
</BaseLayout>

<script>
  function setupServicesVideo() {
    const video = document.getElementById('services-founder-video') as HTMLVideoElement | null;
    const overlay = document.getElementById('services-video-overlay');

    if (!video || !overlay) return;

    video.autoplay = false;
    video.pause();

    overlay.addEventListener('click', () => {
      overlay.classList.add('opacity-0', 'pointer-events-none');
      video.muted = false;
      video.play().catch(() => {
        video.muted = true;
        video.play().catch(() => {});
      });
    });
  }

  setupServicesVideo();
  document.addEventListener('astro:page-load', setupServicesVideo);
</script>
