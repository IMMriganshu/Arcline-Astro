---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionLabel from "../../components/SectionLabel.astro";
import Button from "../../components/Button.astro";
import ProjectCTA from "../../components/ProjectCTA.astro";
import { getChildServiceContent } from "../../lib/cms";

export const prerender = false;

const { serviceSlug } = Astro.params;
const normalizedSlug = serviceSlug === 'local-seo' ? 'local-seo-google-maps' : serviceSlug === 'ai-search' ? 'ai-search-overviews' : (serviceSlug || 'local-seo-google-maps');

const service = await getChildServiceContent(normalizedSlug);
---

<BaseLayout
  title={service.titleTag || "Specialized Search Service | seelutions"}
  description={service.metaDescription || "Specialized patient acquisition and search authority for plastic & facial cosmetic surgeons."}
>
  <!-- Hero Section -->
  <section class="pt-32 pb-16 md:pt-40 md:pb-24 bg-white relative overflow-hidden">
    <div class="max-w-[1440px] mx-auto px-4 sm:px-8 lg:px-12">
      <div class="mb-4" data-animate="fade-up-sm">
        <SectionLabel text={service.badge || "SPECIALIZED SEARCH"} />
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
        <div class="lg:col-span-7">
          <h1 data-animate="fade-up" class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-black tracking-tight text-[#030303] mb-6 leading-[1.1]">
            {service.h1}
          </h1>

          <p data-animate="fade-up-sm" data-animate-delay="1" class="text-lg sm:text-xl font-medium text-neutral-800 leading-relaxed mb-8">
            {service.metaDescription}
          </p>

          <div data-animate="fade-up-sm" data-animate-delay="2" class="flex flex-wrap gap-4">
            <Button href="/#contact" variant="black" showIcon={true} iconType="arrow-right">
              {service.ctaButtonText || "Request Practice Audit"}
            </Button>
            <Button href="/services" variant="outline" showIcon={false}>
              ← Back to All Services
            </Button>
          </div>
        </div>

        <div class="lg:col-span-5" data-animate="scale-in">
          <div class="relative overflow-hidden rounded-3xl shadow-2xl border border-neutral-200 group bg-neutral-900">
            <img
              src={service.image}
              alt={service.h1}
              class="w-full h-[440px] object-cover object-center transition-transform duration-700 ease-out group-hover:scale-105"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
            <div class="absolute bottom-6 left-6 right-6 text-white">
              <span class="text-xs font-bold uppercase tracking-wider text-cyan-400 block mb-1">seelutions Architecture</span>
              <p class="text-lg font-bold">{service.badge}</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 1: The Problem / Shift -->
  <section class="py-16 md:py-24 bg-neutral-50 border-t border-b border-neutral-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-8 text-center">
      <div class="mb-3 inline-block">
        <SectionLabel text="THE BUSINESS REALITY" />
      </div>
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-black text-[#030303] tracking-tight mb-6">
        {service.problemTitle}
      </h2>
      <p class="text-lg sm:text-xl text-neutral-700 leading-relaxed font-medium">
        "{service.problemText}"
      </p>
    </div>
  </section>

  <!-- Section 2: Our Infrastructure (Pillars / Capabilities) -->
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-[1440px] mx-auto px-4 sm:px-8 lg:px-12">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <div class="mb-3 inline-block">
          <SectionLabel text="ENGINEERED INFRASTRUCTURE" />
        </div>
        <h2 class="text-3xl sm:text-4xl font-black text-[#030303] tracking-tight mb-4">
          {service.infrastructureTitle}
        </h2>
        <p class="text-neutral-600 text-base sm:text-lg">
          Proprietary systems built exclusively for high-ticket plastic surgery practices.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {(service.infrastructureItems || []).map((item, index) => (
          <div data-animate="fade-up" class="bg-neutral-50 border border-neutral-200 rounded-2xl md:rounded-3xl p-8 shadow-sm flex flex-col justify-between">
            <div>
              <span class="text-xs font-black tracking-widest px-3 py-1 rounded-full bg-cyan-100 text-cyan-900 inline-block mb-6">
                0{index + 1}
              </span>
              <h3 class="text-xl font-bold text-[#030303] mb-3 tracking-tight">
                {item.title}
              </h3>
              <p class="text-neutral-600 text-sm sm:text-base leading-relaxed">
                {item.desc}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Section 3: Surgeon-Specific Value & CTA Block -->
  <section class="py-16 md:py-24 bg-neutral-950 text-white relative overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(6,182,212,0.15),transparent_50%)] pointer-events-none"></div>
    <div class="max-w-4xl mx-auto px-4 sm:px-8 text-center relative z-10">
      <div class="mb-3 inline-block">
        <span class="px-3.5 py-1.5 rounded-full bg-cyan-950 border border-cyan-800 text-cyan-400 text-xs font-bold uppercase tracking-wider">
          Surgeon-Specific Value
        </span>
      </div>
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-black tracking-tight mb-6 text-white">
        {service.surgeonValueText}
      </h2>

      <div class="pt-8">
        <Button href="/#contact" variant="white" showIcon={true} iconType="arrow-right">
          {service.ctaButtonText || "Request Practice Audit"}
        </Button>
      </div>
    </div>
  </section>

  <ProjectCTA />
</BaseLayout>
