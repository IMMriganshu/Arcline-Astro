---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionLabel from "../components/SectionLabel.astro";
import ProjectCTA from "../components/ProjectCTA.astro";

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=31536000, stale-while-revalidate=86400');
---

<BaseLayout
  title="Contact seelutions — Plastic Surgery Patient Acquisition Studio"
  description="Request a customized 3-minute video audit and strategy consultation for your plastic or facial cosmetic surgery practice."
>
  <div class="relative overflow-hidden pt-28 pb-20 max-w-[1440px] mx-auto px-4 sm:px-8 lg:px-12">
    <!-- Ambient Background Glow -->
    <div class="absolute top-16 left-1/2 -translate-x-1/2 w-[750px] h-[350px] bg-gradient-to-tr from-cyan-500/10 via-blue-500/5 to-transparent blur-3xl pointer-events-none rounded-full -z-10"></div>

    <!-- Breadcrumb / Header Label -->
    <div class="mb-6" data-animate="fade-up">
      <SectionLabel text="GET IN TOUCH" />
    </div>

    <!-- Main Grid: Left = Info & Direct Contacts, Right = Interactive Practice Audit Form -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start mb-20" data-animate="fade-up">
      
      {/* Left Column: Editorial Statement & Direct Contact Details */}
      <div class="lg:col-span-5 space-y-8">
        <div>
          <h1 class="text-3xl sm:text-5xl font-black tracking-tight text-[#030303] leading-[1.1] mb-4">
            Let's Scale Your Surgical Practice
          </h1>
          <p class="text-base sm:text-lg text-neutral-700 leading-relaxed">
            Stop renting $35 clicks. We partner exclusively with board-certified plastic and facial cosmetic surgeons to engineer long-term search authority and predictable high-ticket patient acquisition.
          </p>
        </div>

        <!-- Direct Contact Cards -->
        <div class="space-y-4">
          <div class="p-5 rounded-2xl bg-white border border-black/10 shadow-sm flex items-start gap-4 group hover:border-cyan-500/50 transition-all">
            <div class="w-10 h-10 rounded-xl bg-cyan-500/10 text-cyan-600 flex items-center justify-center font-bold shrink-0 text-lg">
              📞
            </div>
            <div>
              <span class="text-[10px] font-mono tracking-wider uppercase text-neutral-400 font-bold block">Direct Phone</span>
              <a href="tel:8047075821" class="text-base font-bold text-black hover:text-cyan-600 transition-colors">
                (804) 707-5821
              </a>
              <p class="text-xs text-neutral-500 mt-0.5">Mon–Fri from 8:00am – 6:00pm EST</p>
            </div>
          </div>

          <div class="p-5 rounded-2xl bg-white border border-black/10 shadow-sm flex items-start gap-4 group hover:border-cyan-500/50 transition-all">
            <div class="w-10 h-10 rounded-xl bg-cyan-500/10 text-cyan-600 flex items-center justify-center font-bold shrink-0 text-lg">
              ✉️
            </div>
            <div>
              <span class="text-[10px] font-mono tracking-wider uppercase text-neutral-400 font-bold block">Direct Email</span>
              <a href="mailto:hello@seelutions.com" class="text-base font-bold text-black hover:text-cyan-600 transition-colors">
                hello@seelutions.com
              </a>
              <p class="text-xs text-neutral-500 mt-0.5">Response within 24 hours guaranteed</p>
            </div>
          </div>

          <div class="p-5 rounded-2xl bg-white border border-black/10 shadow-sm flex items-start gap-4 group hover:border-cyan-500/50 transition-all">
            <div class="w-10 h-10 rounded-xl bg-cyan-500/10 text-cyan-600 flex items-center justify-center font-bold shrink-0 text-lg">
              📍
            </div>
            <div>
              <span class="text-[10px] font-mono tracking-wider uppercase text-neutral-400 font-bold block">Studio Headquarters</span>
              <p class="text-sm font-semibold text-black mt-0.5">
                567 Jac Spruce Crescent, Montreal, QC H1A 2K3
              </p>
              <p class="text-xs text-neutral-500 mt-0.5">Exclusive Territorial Partnerships</p>
            </div>
          </div>
        </div>

        <!-- Schedule Call Banner Card -->
        <div class="p-6 rounded-3xl bg-neutral-900 text-white relative overflow-hidden group">
          <div class="absolute -right-10 -bottom-10 w-40 h-40 bg-cyan-500/20 rounded-full blur-2xl"></div>
          <h3 class="text-lg font-bold text-white mb-1">Prefer a Direct Discovery Call?</h3>
          <p class="text-xs text-neutral-300 mb-4 leading-relaxed">
            Skip the form and schedule a 20-30 minute free discovery call directly with Langley Holland.
          </p>
          <a
            href="/schedule-a-call"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-cyan-500 hover:bg-cyan-400 text-black font-bold text-xs transition-colors shadow-lg shadow-cyan-500/20"
          >
            <span>Schedule Discovery Call</span>
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>
      </div>

      {/* Right Column: Interactive Practice Audit & Contact Form Card */}
      <div class="lg:col-span-7">
        <div class="bg-white rounded-3xl border border-black/10 shadow-2xl p-6 sm:p-10 relative overflow-hidden">
          <div class="absolute top-0 right-0 w-64 h-64 bg-cyan-500/5 rounded-full blur-3xl pointer-events-none"></div>

          <div class="mb-6">
            <span class="text-[10px] font-mono uppercase font-bold px-3 py-1 rounded-full bg-cyan-50 text-cyan-800 border border-cyan-200">
              Free 3-Minute Practice Audit
            </span>
            <h2 class="text-2xl sm:text-3xl font-black text-black tracking-tight mt-3">
              Request Your Custom Growth Strategy
            </h2>
            <p class="text-xs sm:text-sm text-neutral-600 mt-1">
              Fill out the details below and our team will prepare a tailored video audit of your practice search footprint.
            </p>
          </div>

          <form id="page-contact-form" class="space-y-4">
            <div>
              <label for="p-name" class="block text-xs font-semibold uppercase tracking-wider text-neutral-700 mb-1">
                Doctor / Practice Name *
              </label>
              <input
                type="text"
                id="p-name"
                name="name"
                required
                placeholder="e.g. Dr. Jane Doe / Renewed Look"
                class="w-full px-4 py-3 rounded-xl border border-neutral-200 focus:outline-none focus:border-black focus:ring-1 focus:ring-black text-sm bg-neutral-50/50"
              />
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="p-website" class="block text-xs font-semibold uppercase tracking-wider text-neutral-700 mb-1">
                  Practice Website URL *
                </label>
                <input
                  type="url"
                  id="p-website"
                  name="website"
                  required
                  placeholder="e.g. renewedlook.com"
                  class="w-full px-4 py-3 rounded-xl border border-neutral-200 focus:outline-none focus:border-black focus:ring-1 focus:ring-black text-sm bg-neutral-50/50 font-mono text-xs"
                />
              </div>

              <div>
                <label for="p-email" class="block text-xs font-semibold uppercase tracking-wider text-neutral-700 mb-1">
                  Direct Email Address *
                </label>
                <input
                  type="email"
                  id="p-email"
                  name="email"
                  required
                  placeholder="e.g. hello@practice.com"
                  class="w-full px-4 py-3 rounded-xl border border-neutral-200 focus:outline-none focus:border-black focus:ring-1 focus:ring-black text-sm bg-neutral-50/50"
                />
              </div>
            </div>

            <div>
              <label for="p-phone" class="block text-xs font-semibold uppercase tracking-wider text-neutral-700 mb-1">
                Direct Phone Number *
              </label>
              <input
                type="tel"
                id="p-phone"
                name="phone"
                required
                placeholder="e.g. (555) 000-0000"
                class="w-full px-4 py-3 rounded-xl border border-neutral-200 focus:outline-none focus:border-black focus:ring-1 focus:ring-black text-sm bg-neutral-50/50"
              />
            </div>

            <div>
              <label for="p-focus" class="block text-xs font-semibold uppercase tracking-wider text-neutral-700 mb-1">
                Primary Surgical Focus
              </label>
              <select
                id="p-focus"
                name="focus"
                class="w-full px-4 py-3 rounded-xl border border-neutral-200 focus:outline-none focus:border-black focus:ring-1 focus:ring-black text-sm bg-neutral-50/50 font-medium text-black cursor-pointer"
              >
                <option value="Facelift">Facelift &amp; Facial Rejuvenation</option>
                <option value="Rhinoplasty">Rhinoplasty &amp; Revision</option>
                <option value="Eyelid Surgery">Eyelid Surgery (Blepharoplasty)</option>
                <option value="Neck Lift">Neck Lift &amp; Submentoplasty</option>
                <option value="Body Contouring">Body Contouring &amp; Liposuction</option>
                <option value="Breast">Breast Augmentation &amp; Revision</option>
                <option value="Med Spa">Med Spa &amp; Injectables Pipeline</option>
              </select>
            </div>

            <div id="p-form-success" class="hidden p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs font-medium">
              ✨ Thank you! Your audit request has been received. Our team will prepare your 3-minute video analysis shortly.
            </div>

            <div class="pt-2">
              <button
                type="submit"
                class="w-full py-3.5 px-6 rounded-full bg-black hover:bg-neutral-800 text-white font-bold text-sm tracking-wide shadow-xl transition-all cursor-pointer flex items-center justify-center gap-2 group"
              >
                <span>Request Your Free Practice Audit</span>
                <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>

  <ProjectCTA />

  <script type="module">
    const form = document.getElementById('page-contact-form');
    const successBox = document.getElementById('p-form-success');

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const { db } = await import("../lib/firebase.ts");
      const { collection, addDoc, serverTimestamp } = await import("firebase/firestore");

      const formData = new FormData(form);
      const data = {
        name: formData.get('name'),
        website: formData.get('website'),
        email: formData.get('email'),
        phone: formData.get('phone'),
        focus: formData.get('focus'),
        createdAt: serverTimestamp()
      };

      try {
        await addDoc(collection(db, 'submissions'), data);
        successBox?.classList.remove('hidden');
        form.reset();
        setTimeout(() => {
          successBox?.classList.add('hidden');
        }, 5000);
      } catch (error) {
        console.error("Error submitting contact form:", error);
        alert("There was an error submitting your request. Please try calling us directly at (804) 707-5821.");
      }
    });
  </script>
</BaseLayout>
