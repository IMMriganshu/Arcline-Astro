---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionLabel from "../components/SectionLabel.astro";
import { portfolioProjects } from "../data/siteData";
import ProjectCTA from "../components/ProjectCTA.astro";
---

<BaseLayout
  title="Projects Portfolio — Arcline Architecture"
  description="Explore our built work across residential villas, commercial pavilions, and urban developments."
>
  <div class="pt-32 pb-24 max-w-[1440px] mx-auto px-4 sm:px-8 lg:px-12">
    <div class="mb-4">
      <SectionLabel text="ARCHITECTURAL MONOGRAPHS" />
    </div>

    <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight text-[#030303] mb-6">
      Selected Built Works & Commissions
    </h1>

    <p class="text-lg text-neutral-600 max-w-2xl leading-relaxed mb-16">
      Explore residential, civic, and commercial architecture projects realized across Canada and internationally.
    </p>

    <!-- Projects Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-10 lg:gap-14">
      {portfolioProjects.map((project) => (
        <div class="group flex flex-col justify-between">
          <div>
            <div class="overflow-hidden rounded-3xl aspect-[16/10] bg-neutral-100 border border-black/5 mb-6 shadow-sm">
              <img
                src={project.image}
                alt={project.title}
                class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                loading="lazy"
              />
            </div>

            <div class="flex items-center justify-between text-xs font-mono text-neutral-400 mb-2">
              <span class="text-[#C5A880] font-bold">{project.number}</span>
              <span class="uppercase tracking-wider">{project.location} · {project.year}</span>
            </div>

            <h2 class="text-2xl sm:text-3xl font-bold text-[#030303] group-hover:text-black mb-2 transition-colors">
              {project.title}
            </h2>

            <p class="text-sm text-neutral-600 leading-relaxed">
              {project.description}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>

  <ProjectCTA />
</BaseLayout>
