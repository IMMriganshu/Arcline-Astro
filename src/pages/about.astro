---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionLabel from "../components/SectionLabel.astro";
import Button from "../components/Button.astro";
import ProjectCTA from "../components/ProjectCTA.astro";

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=31536000, stale-while-revalidate=86400');

const pageTitle = "About seelutions | Marketing for Plastic and Cosmetic Surgeons";
const pageDescription = "seelutions is a Richmond, Virginia marketing agency that helps board-certified plastic and facial cosmetic surgeons get found on Google, Google Maps, and AI search.";

const posterUrl = "/assets/aistudio/Owner_Video_Thumbnail_b026f920.jpg";
const videoUrl = "/videos/seelutions_Video_Final.mp4";

const transcriptText = "Hi, my name is Langley. I'm the president of seelutions. I wanted to tell you quickly about my business. We started in 1983 as a graphic design business and in the late ’90s to early 2000s, I transformed it into a digital marketing agency doing SEO and website design. Along the way, I met Dr. Ryan Diepenbrock. He's a board-certified facial cosmetic surgeon up in Fort Wayne, Indiana. And we just had immediate bond and it's been a great relationship. I do SEO, I do website design, I do AI visibility for Dr. Diepenbrock. And right now, he's got more authority than any facial cosmetic surgeon in the geographical area in Fort Wayne. He's ranked number one for facelifts, rhinoplasty, blepharoplasty. He is really doing great. And that being said, we are looking for a few more plastic surgeons or cosmetic surgeons to work with. And it's as simple as emailing us or calling us and setting up a strategy call. We'll tell you what we do. We'll see if we have a nice fit and we'll take it from there. I'd love for you to take a quick look at Dr. Diepenbrock's video testimonial on our website. And once again, we'd love to hear from you and talk to you soon.";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
>
  <!-- Section A: Top Section (Hero) -->
  <section class="pt-32 pb-16 md:pt-40 md:pb-24 bg-white relative overflow-hidden">
    <div class="max-w-[1440px] mx-auto px-4 sm:px-8 lg:px-12">
      <div class="mb-4" data-animate="fade-up-sm">
        <SectionLabel text="ABOUT SEELUTIONS" />
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
        <!-- Left Text Column -->
        <div class="lg:col-span-7 flex flex-col justify-center">
          <h1 data-animate="fade-up" class="text-3xl sm:text-4xl md:text-5xl lg:text-[3.25rem] font-bold tracking-tight text-[#030303] leading-[1.12] mb-6 font-urbanist">
            Helping Surgeons Get Found, and Chosen
          </h1>

          <p data-animate="fade-up-sm" data-animate-delay="1" class="text-lg sm:text-xl font-medium text-neutral-800 leading-relaxed mb-8 max-w-2xl">
            seelutions is a Richmond, Virginia marketing agency that specializes in board-certified plastic and facial cosmetic surgeons. We help practices show up on Google, Google Maps, and AI search, and turn that visibility into consultations.
          </p>

          <div data-animate="fade-up-sm" data-animate-delay="2" class="flex flex-wrap items-center gap-4">
            <Button href="https://audit.seelutions.com/" variant="black" showIcon={true} iconType="arrow-right">
              Get Your Free Practice Visibility Audit
            </Button>
            <Button href="/schedule-a-call" variant="outline" showIcon={false}>
              Schedule a Call
            </Button>
          </div>
        </div>

        <!-- Right Column: Facts Box (Navy and Gold) -->
        <div class="lg:col-span-5" data-animate="scale-in">
          <div class="relative bg-[#051329] text-white rounded-3xl p-7 sm:p-9 shadow-2xl border border-white/10 overflow-hidden">
            <!-- Background Radial Glow -->
            <div class="absolute -top-12 -right-12 w-48 h-48 bg-[#C5A880]/15 rounded-full blur-2xl pointer-events-none"></div>

            <h3 class="text-xs font-bold tracking-widest text-[#C5A880] uppercase mb-6 border-b border-white/10 pb-3">
              AT A GLANCE
            </h3>

            <div class="space-y-6">
              <!-- Fact 1 -->
              <div class="flex flex-col border-b border-white/10 pb-5">
                <span class="text-3xl sm:text-4xl font-bold text-[#C5A880] font-urbanist mb-1">
                  Since 1983
                </span>
                <span class="text-sm text-neutral-300 font-medium">
                  in business, starting as a graphic design studio
                </span>
              </div>

              <!-- Fact 2 -->
              <div class="flex flex-col border-b border-white/10 pb-5">
                <span class="text-3xl sm:text-4xl font-bold text-[#C5A880] font-urbanist mb-1">
                  10+ years
                </span>
                <span class="text-sm text-neutral-300 font-medium">
                  partnered with Dr. Ryan Diepenbrock
                </span>
              </div>

              <!-- Fact 3 -->
              <div class="flex flex-col">
                <span class="text-3xl sm:text-4xl font-bold text-[#C5A880] font-urbanist mb-1">
                  1 practice
                </span>
                <span class="text-sm text-neutral-300 font-medium">
                  per metropolitan territory
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section B: Our Story -->
  <section class="py-16 md:py-24 bg-neutral-50 border-t border-b border-neutral-200/80">
    <div class="max-w-[1440px] mx-auto px-4 sm:px-8 lg:px-12">
      <div class="mb-12 text-center max-w-3xl mx-auto">
        <div class="mb-3" data-animate="fade-up-sm">
          <SectionLabel text="OUR STORY" />
        </div>
        <h2 data-animate="fade-up" class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-[#030303] font-urbanist">
          Four decades of helping businesses be seen
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Card 1 -->
        <div data-animate="fade-up" class="bg-white p-7 sm:p-9 rounded-3xl border border-neutral-200/80 shadow-sm flex flex-col justify-between hover:shadow-md transition-shadow">
          <div>
            <span class="inline-block px-3 py-1 rounded-full bg-amber-100/70 text-[#C5A880] font-bold text-xs tracking-wider uppercase mb-4">
              1983
            </span>
            <h3 class="text-xl font-bold text-[#030303] font-urbanist mb-3">
              A design studio
            </h3>
            <p class="text-neutral-600 text-sm sm:text-base leading-relaxed">
              seelutions started as a graphic design business, building brands and marketing materials.
            </p>
          </div>
        </div>

        <!-- Card 2 -->
        <div data-animate="fade-up" data-animate-delay="1" class="bg-white p-7 sm:p-9 rounded-3xl border border-neutral-200/80 shadow-sm flex flex-col justify-between hover:shadow-md transition-shadow">
          <div>
            <span class="inline-block px-3 py-1 rounded-full bg-amber-100/70 text-[#C5A880] font-bold text-xs tracking-wider uppercase mb-4">
              LATE 1990s
            </span>
            <h3 class="text-xl font-bold text-[#030303] font-urbanist mb-3">
              Going digital
            </h3>
            <p class="text-neutral-600 text-sm sm:text-base leading-relaxed">
              As patients and customers moved online, we became a digital marketing agency focused on SEO and website design.
            </p>
          </div>
        </div>

        <!-- Card 3 -->
        <div data-animate="fade-up" data-animate-delay="2" class="bg-white p-7 sm:p-9 rounded-3xl border border-neutral-200/80 shadow-sm flex flex-col justify-between hover:shadow-md transition-shadow">
          <div>
            <span class="inline-block px-3 py-1 rounded-full bg-amber-100/70 text-[#C5A880] font-bold text-xs tracking-wider uppercase mb-4">
              TODAY
            </span>
            <h3 class="text-xl font-bold text-[#030303] font-urbanist mb-3">
              Focused on surgeons
            </h3>
            <p class="text-neutral-600 text-sm sm:text-base leading-relaxed">
              We specialize in plastic and facial cosmetic surgeons, including AI search, so practices are found wherever patients look.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section C: Meet the Founder -->
  <section class="py-16 md:py-24 bg-white" id="meet-founder">
    <div class="max-w-[1440px] mx-auto px-4 sm:px-8 lg:px-12">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
        
        <!-- Left Column: Wording & Founder Bio -->
        <div class="lg:col-span-6 flex flex-col">
          <div class="mb-3" data-animate="fade-up-sm">
            <SectionLabel text="MEET THE FOUNDER" />
          </div>
          <h2 data-animate="fade-up" class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-[#030303] font-urbanist mb-2">
            Langley Holland
          </h2>
          <span class="text-base sm:text-lg font-semibold text-[#C5A880] mb-6 block">
            Founder of seelutions
          </span>

          <p data-animate="fade-up-sm" data-animate-delay="1" class="text-base sm:text-lg text-neutral-700 leading-relaxed mb-4">
            Langley started seelutions in 1983 as a graphic design business and grew it into a digital marketing agency for surgical practices. He works hands-on with clients on SEO, website design, and AI visibility.
          </p>
          <p data-animate="fade-up-sm" data-animate-delay="2" class="text-base sm:text-lg text-neutral-700 leading-relaxed mb-8">
            Watch his short video to hear how seelutions works and who we are looking to partner with.
          </p>

          <div>
            <!-- Read the Transcript Toggle -->
            <button
              id="about-toggle-transcript-btn"
              type="button"
              class="inline-flex items-center gap-1.5 text-sm font-medium text-[#C5A880] hover:text-[#b09269] transition-colors cursor-pointer group focus:outline-none"
              aria-expanded="false"
              aria-controls="about-transcript-content"
            >
              <span>Read the transcript</span>
              <svg
                id="about-transcript-chevron"
                class="w-4 h-4 transition-transform duration-300 transform group-hover:translate-y-0.5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </button>
          </div>
        </div>

        <!-- Right Column: Video Thumbnail Container (No Autoplay, CC button off by default) -->
        <div class="lg:col-span-6" data-animate="scale-in">
          <div class="relative overflow-hidden rounded-2xl sm:rounded-3xl shadow-2xl border border-black/10 aspect-[16/9] group bg-neutral-950">
            <!-- Cover Image -->
            <img
              src={posterUrl}
              alt="Langley Holland, Founder of seelutions"
              class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
              loading="eager"
              decoding="async"
            />

            <!-- Dark Overlay -->
            <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/20 to-black/30 transition-colors group-hover:bg-black/40 pointer-events-none"></div>

            <!-- Play Button Overlay -->
            <div class="absolute inset-0 flex flex-col items-center justify-center z-20 gap-3 p-4 text-center">
              <button
                id="about-play-video-btn"
                type="button"
                class="w-16 h-16 sm:w-20 sm:h-20 rounded-full bg-white/25 hover:bg-white/40 text-white backdrop-blur-md border border-white/40 flex items-center justify-center shadow-2xl transition-all duration-300 transform group-hover:scale-110 cursor-pointer focus:outline-none"
                aria-label="Play video message from Langley Holland"
              >
                <svg class="w-8 h-8 sm:w-9 sm:h-9 translate-x-0.5 fill-current" viewBox="0 0 24 24">
                  <path d="M8 5v14l11-7z" />
                </svg>
              </button>
              <span class="text-xs sm:text-sm font-semibold tracking-wider text-white/90 uppercase drop-shadow-md">
                Watch Video (1:20)
              </span>
            </div>
          </div>
        </div>

      </div>

      <!-- Collapsible Transcript Drawer -->
      <div
        id="about-transcript-content"
        class="hidden max-w-4xl mx-auto mt-8 p-6 sm:p-8 rounded-2xl bg-neutral-50 border border-neutral-200 shadow-sm transition-all duration-300"
      >
        <div class="flex items-center justify-between pb-3 mb-4 border-b border-neutral-200">
          <span class="text-xs font-bold tracking-widest text-[#C5A880] uppercase">Official Video Transcript</span>
          <span class="text-xs text-neutral-500 font-medium">Langley Holland · Founder of seelutions</span>
        </div>
        <p class="text-sm sm:text-base text-neutral-700 font-normal leading-relaxed text-justify sm:text-left">
          {transcriptText}
        </p>
      </div>

    </div>
  </section>

  <!-- Video Modal Dialog with CC Controls (CC off by default) -->
  <div
    id="about-video-modal"
    class="fixed inset-0 z-50 bg-black/95 backdrop-blur-md hidden items-center justify-center p-4 sm:p-8"
  >
    <div class="relative w-full max-w-5xl bg-black rounded-2xl overflow-hidden shadow-2xl border border-white/10 flex flex-col">
      <!-- Modal Top Bar -->
      <div class="absolute top-4 right-4 z-30 flex items-center gap-3">
        <!-- CC Toggle Button (CC disabled by default) -->
        <button
          id="about-toggle-modal-cc-btn"
          type="button"
          class="px-3 py-1.5 rounded-full bg-white/10 hover:bg-white/20 text-white font-bold text-xs tracking-wider border border-white/20 flex items-center gap-1.5 transition-colors cursor-pointer"
          title="Toggle Closed Captions (CC)"
          aria-label="Toggle Closed Captions"
        >
          <span class="w-2 h-2 rounded-full bg-neutral-500 transition-opacity" id="about-cc-status-dot"></span>
          <span>CC</span>
        </button>

        <!-- Close Button -->
        <button
          id="about-close-video-modal"
          type="button"
          class="w-10 h-10 rounded-full bg-white/10 hover:bg-white/20 text-white flex items-center justify-center transition-colors cursor-pointer"
          aria-label="Close video"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Video Player Frame -->
      <div class="aspect-video w-full bg-black flex items-center justify-center relative group/player">
        <video
          id="about-modal-video"
          controls
          playsinline
          poster={posterUrl}
          class="w-full h-full"
        >
          <source src={videoUrl} type="video/mp4" />
          <track
            id="about-modal-cc-track"
            kind="subtitles"
            src="/subtitles/langley-founder.vtt"
            srclang="en"
            label="English"
          />
        </video>

        <!-- Custom Subtitle Overlay -->
        <div
          id="about-cc-caption-overlay"
          class="absolute bottom-12 left-4 right-4 sm:left-12 sm:right-12 text-center pointer-events-none transition-opacity duration-200 z-20 hidden opacity-0"
        >
          <span
            id="about-cc-caption-text"
            class="inline-block bg-black/85 text-white text-xs sm:text-base md:text-lg font-medium px-4 py-2 rounded-xl border border-white/10 shadow-xl max-w-2xl leading-snug"
          >
            Hi, my name is Langley. I'm the president of seelutions.
          </span>
        </div>
      </div>
    </div>
  </div>

  <!-- Section D: What Makes Us Different -->
  <section class="py-16 md:py-24 bg-neutral-50 border-t border-b border-neutral-200/80">
    <div class="max-w-[1440px] mx-auto px-4 sm:px-8 lg:px-12">
      <div class="mb-12 text-center max-w-3xl mx-auto">
        <div class="mb-3" data-animate="fade-up-sm">
          <SectionLabel text="HOW WE WORK" />
        </div>
        <h2 data-animate="fade-up" class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-[#030303] font-urbanist">
          What makes us different
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Card 1 -->
        <div data-animate="fade-up" class="bg-white p-7 sm:p-9 rounded-3xl border border-neutral-200/80 shadow-sm flex flex-col justify-between hover:shadow-md transition-shadow">
          <div>
            <div class="w-12 h-12 rounded-2xl bg-[#051329] text-[#C5A880] flex items-center justify-center font-bold text-lg mb-6 shadow-xs font-urbanist">
              01
            </div>
            <h3 class="text-xl font-bold text-[#030303] font-urbanist mb-3">
              One practice per market
            </h3>
            <p class="text-neutral-600 text-sm sm:text-base leading-relaxed">
              We partner with one board-certified plastic or facial cosmetic surgical practice per metropolitan territory. So we never work for a competitor in your market.
            </p>
          </div>
        </div>

        <!-- Card 2 -->
        <div data-animate="fade-up" data-animate-delay="1" class="bg-white p-7 sm:p-9 rounded-3xl border border-neutral-200/80 shadow-sm flex flex-col justify-between hover:shadow-md transition-shadow">
          <div>
            <div class="w-12 h-12 rounded-2xl bg-[#051329] text-[#C5A880] flex items-center justify-center font-bold text-lg mb-6 shadow-xs font-urbanist">
              02
            </div>
            <h3 class="text-xl font-bold text-[#030303] font-urbanist mb-3">
              Long-term partners
            </h3>
            <p class="text-neutral-600 text-sm sm:text-base leading-relaxed">
              Our relationships last. Dr. Ryan Diepenbrock has worked with us for more than ten years.
            </p>
          </div>
        </div>

        <!-- Card 3 -->
        <div data-animate="fade-up" data-animate-delay="2" class="bg-white p-7 sm:p-9 rounded-3xl border border-neutral-200/80 shadow-sm flex flex-col justify-between hover:shadow-md transition-shadow">
          <div>
            <div class="w-12 h-12 rounded-2xl bg-[#051329] text-[#C5A880] flex items-center justify-center font-bold text-lg mb-6 shadow-xs font-urbanist">
              03
            </div>
            <h3 class="text-xl font-bold text-[#030303] font-urbanist mb-3">
              Ready for AI search
            </h3>
            <p class="text-neutral-600 text-sm sm:text-base leading-relaxed">
              Patients now ask ChatGPT and Google's AI answers which surgeon to see. We make sure your practice is part of that answer.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section E: Audit CTA Section -->
  <ProjectCTA />

</BaseLayout>

<script>
  function setupAboutPageVideo() {
    const playBtn = document.getElementById('about-play-video-btn');
    const videoModal = document.getElementById('about-video-modal');
    const closeModalBtn = document.getElementById('about-close-video-modal');
    const modalVideo = document.getElementById('about-modal-video') as HTMLVideoElement | null;
    const toggleCcBtn = document.getElementById('about-toggle-modal-cc-btn');
    const ccStatusDot = document.getElementById('about-cc-status-dot');
    const ccCaptionOverlay = document.getElementById('about-cc-caption-overlay');
    const ccCaptionText = document.getElementById('about-cc-caption-text');
    const toggleTranscriptBtn = document.getElementById('about-toggle-transcript-btn');
    const transcriptContent = document.getElementById('about-transcript-content');
    const transcriptChevron = document.getElementById('about-transcript-chevron');

    let ccEnabled = false; // Closed Captions off by default per specification

    const cues = [
      { start: 0.0, end: 4.5, text: "Hi, my name is Langley. I'm the president of seelutions. I wanted to tell you quickly about my business." },
      { start: 4.5, end: 12.5, text: "We started in 1983 as a graphic design business and in the late ’90s to early 2000s, I transformed it into a digital marketing agency doing SEO and website design." },
      { start: 12.5, end: 19.5, text: "Along the way, I met Dr. Ryan Diepenbrock. He's a board-certified facial cosmetic surgeon up in Fort Wayne, Indiana." },
      { start: 19.5, end: 25.0, text: "And we just had immediate bond and it's been a great relationship." },
      { start: 25.0, end: 32.0, text: "I do SEO, I do website design, I do AI visibility for Dr. Diepenbrock." },
      { start: 32.0, end: 40.0, text: "And right now, he's got more authority than any facial cosmetic surgeon in the geographical area in Fort Wayne." },
      { start: 40.0, end: 47.0, text: "He's ranked number one for facelifts, rhinoplasty, blepharoplasty. He is really doing great." },
      { start: 47.0, end: 54.0, text: "And that being said, we are looking for a few more plastic surgeons or cosmetic surgeons to work with." },
      { start: 54.0, end: 62.0, text: "And it's as simple as emailing us or calling us and setting up a strategy call. We'll tell you what we do." },
      { start: 62.0, end: 68.0, text: "We'll see if we have a nice fit and we'll take it from there." },
      { start: 68.0, end: 75.0, text: "I'd love for you to take a quick look at Dr. Diepenbrock's video testimonial on our website." },
      { start: 75.0, end: 85.0, text: "And once again, we'd love to hear from you and talk to you soon." }
    ];

    // Transcript Drawer Toggle Listener
    if (toggleTranscriptBtn && transcriptContent && transcriptChevron) {
      toggleTranscriptBtn.addEventListener('click', () => {
        const isHidden = transcriptContent.classList.contains('hidden');
        if (isHidden) {
          transcriptContent.classList.remove('hidden');
          toggleTranscriptBtn.setAttribute('aria-expanded', 'true');
          transcriptChevron.classList.add('rotate-180');
        } else {
          transcriptContent.classList.add('hidden');
          toggleTranscriptBtn.setAttribute('aria-expanded', 'false');
          transcriptChevron.classList.remove('rotate-180');
        }
      });
    }

    // CC Toggle Listener
    function updateCcDisplay() {
      if (!modalVideo) return;
      const track = modalVideo.textTracks && modalVideo.textTracks[0];
      if (track) {
        track.mode = ccEnabled ? 'showing' : 'hidden';
      }
      if (ccStatusDot) {
        if (ccEnabled) {
          ccStatusDot.classList.remove('bg-neutral-500');
          ccStatusDot.classList.add('bg-emerald-400');
        } else {
          ccStatusDot.classList.remove('bg-emerald-400');
          ccStatusDot.classList.add('bg-neutral-500');
        }
      }
      if (ccCaptionOverlay) {
        if (ccEnabled) {
          ccCaptionOverlay.classList.remove('hidden');
        } else {
          ccCaptionOverlay.classList.add('hidden');
        }
      }
    }

    toggleCcBtn?.addEventListener('click', () => {
      ccEnabled = !ccEnabled;
      updateCcDisplay();
    });

    modalVideo?.addEventListener('timeupdate', () => {
      if (!ccEnabled || !ccCaptionText || !modalVideo) return;
      const currentTime = modalVideo.currentTime;
      const activeCue = cues.find(c => currentTime >= c.start && currentTime <= c.end);
      if (activeCue) {
        ccCaptionText.textContent = activeCue.text;
        if (ccCaptionOverlay) ccCaptionOverlay.style.opacity = '1';
      } else {
        if (ccCaptionOverlay) ccCaptionOverlay.style.opacity = '0';
      }
    });

    if (!playBtn || !videoModal) return;

    playBtn.addEventListener('click', () => {
      videoModal.classList.remove('hidden');
      videoModal.classList.add('flex');
      if (modalVideo) {
        modalVideo.currentTime = 0;
        updateCcDisplay();
        modalVideo.play().catch(() => {});
      }
    });

    const closeModal = () => {
      videoModal.classList.add('hidden');
      videoModal.classList.remove('flex');
      if (modalVideo) {
        modalVideo.pause();
      }
    };

    closeModalBtn?.addEventListener('click', closeModal);

    videoModal.addEventListener('click', (e) => {
      if (e.target === videoModal) {
        closeModal();
      }
    });
  }

  setupAboutPageVideo();
  document.addEventListener('astro:page-load', setupAboutPageVideo);
</script>
