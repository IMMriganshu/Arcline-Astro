---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionLabel from "../components/SectionLabel.astro";
import Button from "../components/Button.astro";
import ProjectCTA from "../components/ProjectCTA.astro";
import { getAboutContent } from "../lib/cms";
export const prerender = false;
Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=31536000, stale-while-revalidate=86400');

const about = await getAboutContent();
---

<BaseLayout
  title="About Us & 10-Year Practice Case Study — Specialized Patient Acquisition"
  description="How Dr. Ryan Diepenbrock scaled to regional market dominance across a decade of digital shift."
>
  <div class="pt-24 pb-16 max-w-[1440px] mx-auto px-4 sm:px-8 lg:px-12">
    <!-- Breadcrumb / Header -->
    <div class="mb-3">
      <SectionLabel text={about.badge || "ABOUT US"} />
    </div>

    <!-- Large Editorial Narrative Statement -->
    <div class="max-w-4xl mb-10 md:mb-12">
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold tracking-tight text-[#030303] leading-tight mb-5">
        {about.title}
      </h1>
      <div class="text-xl sm:text-2xl font-medium text-neutral-800 leading-relaxed mb-4 prose prose-p:my-1 prose-headings:my-2 prose-a:text-cyan-600 prose-a:underline" set:html={about.subtitle} />
      <div class="text-base sm:text-lg text-neutral-600 leading-relaxed prose prose-p:my-1 prose-headings:my-2 prose-a:text-cyan-600 prose-a:underline" set:html={about.description} />
    </div>

    <!-- 2-Column Layout: Left = Eyeball Image, Right = Growth Timeline Block -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-stretch mb-16">
      <!-- Left Column: Clean Eyeball Image -->
      <div class="lg:col-span-7 flex">
        <div class="overflow-hidden rounded-2xl md:rounded-3xl shadow-lg border border-black/5 w-full h-full min-h-[320px] group bg-neutral-950 flex">
          <img
            src="/images/Eyeball BC.webp"
            alt="Specialized bionic eyeball digital aesthetic for plastic and facial cosmetic surgeons"
            class="w-full h-full object-cover object-center transition-transform duration-700 ease-out group-hover:scale-105"
            loading="lazy"
          />
        </div>
      </div>

      <!-- Right Column: Results & 10-Year Timeline Panel -->
      <div class="lg:col-span-5 flex">
        <div class="bg-white border border-neutral-200/90 rounded-2xl md:rounded-3xl p-5 sm:p-6 shadow-lg w-full flex flex-col justify-between">
          <div>
            <div class="mb-4">
              <h3 class="text-lg sm:text-xl font-bold tracking-tight text-[#050505] mb-1">
                Results for Diepenbrock Facial Cosmetic Surgery
              </h3>
              <p class="text-xs text-neutral-500 font-normal">
                2026 verified results
              </p>
            </div>

            <!-- 2x2 Stats Grid -->
            <div class="grid grid-cols-2 gap-3 mb-5">
              <div class="bg-[#F4F2EE] rounded-xl p-3.5 flex flex-col justify-center">
                <span class="text-xl sm:text-2xl font-bold text-neutral-900 leading-tight">35 of 62</span>
                <span class="text-xs text-neutral-600 font-normal mt-1 leading-snug">Google searches in top 3</span>
              </div>
              <div class="bg-[#F4F2EE] rounded-xl p-3.5 flex flex-col justify-center">
                <span class="text-xl sm:text-2xl font-bold text-neutral-900 leading-tight">+158%</span>
                <span class="text-xs text-neutral-600 font-normal mt-1 leading-snug">Google Maps views</span>
              </div>
              <div class="bg-[#F4F2EE] rounded-xl p-3.5 flex flex-col justify-center">
                <span class="text-xl sm:text-2xl font-bold text-neutral-900 leading-tight">+43%</span>
                <span class="text-xs text-neutral-600 font-normal mt-1 leading-snug">Phone calls from Google</span>
              </div>
              <div class="bg-[#F4F2EE] rounded-xl p-3.5 flex flex-col justify-center">
                <span class="text-xl sm:text-2xl font-bold text-neutral-900 leading-tight">+48%</span>
                <span class="text-xs text-neutral-600 font-normal mt-1 leading-snug">Direction requests</span>
              </div>
            </div>

            <!-- Small Heading: A decade of staying ahead -->
            <h4 class="text-xs sm:text-sm font-bold text-neutral-900 mb-2.5 tracking-tight">
              A decade of staying ahead
            </h4>

            <!-- Four Rows with NO dollar amounts -->
            <div class="space-y-2">
              <div class="bg-white px-3.5 py-2.5 rounded-xl border border-neutral-200 shadow-2xs flex items-center justify-between gap-2">
                <span class="text-xs font-semibold text-[#00A0DC] tracking-tight shrink-0">2016</span>
                <span class="text-xs font-normal text-neutral-700 text-right">Local search foundation</span>
              </div>
              <div class="bg-white px-3.5 py-2.5 rounded-xl border border-neutral-200 shadow-2xs flex items-center justify-between gap-2">
                <span class="text-xs font-semibold text-[#00A0DC] tracking-tight shrink-0">2018</span>
                <span class="text-xs font-normal text-neutral-700 text-right">Procedure pages and galleries</span>
              </div>
              <div class="bg-white px-3.5 py-2.5 rounded-xl border border-neutral-200 shadow-2xs flex items-center justify-between gap-2">
                <span class="text-xs font-semibold text-[#00A0DC] tracking-tight shrink-0">2021</span>
                <span class="text-xs font-normal text-neutral-700 text-right">Mobile and Google Maps growth</span>
              </div>
              <div class="bg-white px-3.5 py-2.5 rounded-xl border border-neutral-200 shadow-2xs flex items-center justify-between gap-2">
                <span class="text-xs font-semibold text-[#00A0DC] tracking-tight shrink-0">2024 to today</span>
                <span class="text-xs font-normal text-neutral-700 text-right">AI search</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <ProjectCTA />
</BaseLayout>
