---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import AboutSection from "../components/AboutSection.astro";
import ComparisonSection from "../components/ComparisonSection.astro";
import ServicesSection from "../components/ServicesSection.astro";
import PortfolioSection from "../components/PortfolioSection.astro";
import VideoShowcase from "../components/VideoShowcase.astro";
import TestimonialSection from "../components/TestimonialSection.astro";
import BlogSection from "../components/BlogSection.astro";
import ProjectCTA from "../components/ProjectCTA.astro";
export const prerender = false;
Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=31536000, stale-while-revalidate=86400');
---

<BaseLayout>
  <!-- Hero Section with Masked Typography -->
  <Hero />

  <!-- About Section with Asymmetric Grid -->
  <AboutSection />

  <!-- Comparison Section -->
  <ComparisonSection />

  <!-- Our Selected Services with Large Numerals -->
  <ServicesSection />

  <!-- Portfolio Section with Oversized Recent Works Typography -->
  <PortfolioSection />

  <!-- Large Architectural Video Showcase -->
  <VideoShowcase />

  <!-- Interactive Client Testimonials Carousel -->
  <TestimonialSection />

  <!-- B2B Content Hub: Patient Grower Editorial Grid -->
  <BlogSection />

  <!-- Dark Cinematic Project CTA -->
  <ProjectCTA />
</BaseLayout>
