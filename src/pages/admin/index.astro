---
import AdminDashboard from '../../components/admin/AdminDashboard';
import '../../styles/global.css';

export const prerender = true;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>seelutions — Headless CMS Studio</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/webp" href="/images/seelutions%20brand%20icon.webp" />
    <link rel="apple-touch-icon" href="/images/seelutions%20brand%20icon.webp" />
    <!-- Google Font: Urbanist -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Urbanist:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-[#030712] text-white min-h-screen">
    <AdminDashboard client:only="react" />
  </body>
</html>
