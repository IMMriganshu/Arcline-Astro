---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionLabel from "../components/SectionLabel.astro";
import Button from "../components/Button.astro";
---

<BaseLayout
  title="Page Not Found — Arcline"
  description="The requested page could not be located."
>
  <div class="pt-40 pb-32 max-w-[1440px] mx-auto px-4 sm:px-8 lg:px-12 text-center">
    <div class="mb-4 flex justify-center">
      <SectionLabel text="404 ERROR" />
    </div>

    <h1 class="text-6xl sm:text-8xl md:text-9xl font-black tracking-tight text-[#030303] mb-6">
      404
    </h1>

    <p class="text-xl sm:text-2xl font-medium text-neutral-800 mb-4">
      Page Not Found
    </p>

    <p class="text-neutral-500 max-w-md mx-auto text-sm sm:text-base mb-8">
      The spatial blueprint you are seeking does not exist or has been relocated to another site sector.
    </p>

    <div class="flex justify-center">
      <Button href="/" variant="black" showIcon={true} iconType="arrow-right">
        Return to Homepage
      </Button>
    </div>
  </div>
</BaseLayout>
