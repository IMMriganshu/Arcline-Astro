---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/Button.astro";
import { getArticles, getArticleBySlug, defaultArticles } from "../../lib/cms";

export const prerender = true;

export async function getStaticPaths() {
  const articles = getArticles();
  const list = articles && articles.length > 0 ? articles : defaultArticles;
  return list.map((art) => ({
    params: { slug: art.slug },
    props: { article: art },
  }));
}

const { slug } = Astro.params;
const articleProp = Astro.props.article;
const article = articleProp || (slug ? getArticleBySlug(slug) : null) || defaultArticles[0];

if (!article) {
  return Astro.redirect("/404");
}
---

<BaseLayout
  title={`${article.title} — Arcline Editorial`}
  description={article.excerpt}
>
  <article class="pt-32 pb-24 bg-[#030712] text-white min-h-screen">
    <div class="max-w-[840px] mx-auto px-4 sm:px-6">
      <!-- Back Link -->
      <a
        href="/#blog"
        class="inline-flex items-center gap-2 text-xs font-semibold text-cyan-400 hover:text-cyan-300 transition-colors mb-8"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        <span>Back to Patient Grower Editorial</span>
      </a>

      <!-- Header Info -->
      <header class="mb-10">
        <div class="flex items-center gap-3 text-xs text-neutral-400 mb-4">
          <span class="px-2.5 py-1 rounded-full bg-cyan-950 border border-cyan-800/40 text-cyan-300 font-semibold text-[11px]">
            {article.category}
          </span>
          <span>·</span>
          <span>{article.date}</span>
          <span>·</span>
          <span>{article.readTime}</span>
        </div>

        <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white font-urbanist leading-[1.15] mb-6">
          {article.title}
        </h1>

        <p class="text-lg text-neutral-300 leading-relaxed font-light">
          {article.excerpt}
        </p>
      </header>

      <!-- Featured Image -->
      {article.image && (
        <div class="rounded-2xl overflow-hidden mb-12 border border-white/10 shadow-2xl aspect-[16/9] bg-neutral-900">
          <img
            src={article.image}
            alt={article.title}
            class="w-full h-full object-cover"
          />
        </div>
      )}

      <!-- Body Content -->
      <div class="prose prose-invert prose-cyan max-w-none text-neutral-200 leading-relaxed space-y-6 text-base" set:html={article.content}>
      </div>

      <!-- Footer CTA -->
      <div class="mt-16 p-8 rounded-2xl bg-neutral-900/80 border border-white/10 text-center relative overflow-hidden">
        <div class="relative z-10 max-w-md mx-auto">
          <h3 class="text-xl font-bold font-urbanist text-white mb-2">Ready to dominate search in your metropolitan market?</h3>
          <p class="text-xs text-neutral-400 mb-6">We partner exclusively with one board-certified plastic surgical practice per metropolitan territory.</p>
          <Button href="/#contact" variant="black" showIcon={true} class="justify-center">
            Request Practice Territory Audit
          </Button>
        </div>
      </div>
    </div>
  </article>
</BaseLayout>
