---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Button from "../../components/Button.astro";
import { getArticles, getArticleBySlug } from "../../lib/cms";

export const prerender = false;

const { slug } = Astro.params;
const article = await getArticleBySlug(slug || '');

if (!article) {
  return Astro.redirect("/404");
}

const allArticles = await getArticles();
const relatedArticles = allArticles
  .filter((a) => a.published && a.slug !== article.slug)
  .slice(0, 3);
const articleSeo = article.seo;
const articleTitle = articleSeo?.title || `${article.title} — Seelutions Intelligence`;
const articleDesc = articleSeo?.description || article.excerpt;
const articleImage = articleSeo?.ogImage || article.image;
const articleCanonical = articleSeo?.canonicalUrl || Astro.url.href;

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": article.title,
  "description": articleDesc,
  "image": articleImage.startsWith('http') ? articleImage : `${Astro.url.origin}${articleImage}`,
  "datePublished": article.date ? new Date(article.date).toISOString() : new Date().toISOString(),
  "author": {
    "@type": "Organization",
    "name": "Seelutions Studio"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Seelutions",
    "logo": {
      "@type": "ImageObject",
      "url": `${Astro.url.origin}/images/seelutions%20new%20updatedLogo.png`
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": articleCanonical
  }
};
---

<BaseLayout
  title={articleTitle}
  description={articleDesc}
  ogImage={articleImage}
  canonicalUrl={articleCanonical}
  keywords={articleSeo?.keywords}
  customSchemaData={articleSchema}
>
  <article class="pt-32 pb-24 bg-[#030712] text-white min-h-screen selection:bg-cyan-500 selection:text-black">
    <div class="max-w-[900px] mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumb Navigation -->
      <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-xs text-neutral-400 mb-8 font-medium">
        <a href="/" class="hover:text-cyan-400 transition-colors">Home</a>
        <span>/</span>
        <a href="/blog" class="hover:text-cyan-400 transition-colors">Patient Grower</a>
        <span>/</span>
        <span class="text-neutral-200 truncate max-w-[240px] sm:max-w-md">{article.title}</span>
      </nav>

      <!-- Header Info -->
      <header class="mb-10 pb-8 border-b border-white/10">
        <div class="flex flex-wrap items-center gap-3 text-xs text-neutral-400 mb-5">
          <span class="px-3 py-1 rounded-full bg-cyan-950 border border-cyan-500/40 text-cyan-300 font-semibold text-xs tracking-wide">
            {article.category}
          </span>
          <span>•</span>
          <span class="text-neutral-300">{article.date}</span>
          <span>•</span>
          <span class="text-neutral-300">{article.readTime}</span>
        </div>

        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-white font-urbanist leading-[1.12] mb-6">
          {article.title}
        </h1>

        <p class="text-lg sm:text-xl text-neutral-300 leading-relaxed font-light">
          {article.excerpt}
        </p>

        <!-- Author / Editorial Meta Bar -->
        <div class="mt-8 pt-6 border-t border-white/5 flex flex-wrap items-center justify-between gap-4">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-full bg-gradient-to-br from-cyan-500 to-blue-600 flex items-center justify-center font-bold text-white text-sm shadow-md">
              PG
            </div>
            <div>
              <div class="text-sm font-bold text-white font-urbanist">Patient Grower Intelligence</div>
              <div class="text-xs text-neutral-400">Seelutions Practice Growth Strategy</div>
            </div>
          </div>

          <!-- Share Actions -->
          <div class="flex items-center gap-2">
            <button
              id="copy-article-link"
              type="button"
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white/5 hover:bg-white/10 border border-white/10 text-xs font-medium text-neutral-300 transition-colors cursor-pointer"
              title="Copy link to clipboard"
            >
              <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
              </svg>
              <span id="copy-text">Share Article</span>
            </button>
          </div>
        </div>
      </header>

      <!-- Featured Hero Image -->
      {article.image && (
        <div class="rounded-2xl overflow-hidden mb-12 border border-white/10 shadow-2xl aspect-[16/9] bg-neutral-900 relative">
          <img
            src={article.image}
            alt={article.title}
            class="w-full h-full object-cover"
          />
        </div>
      )}

      <!-- Rich Article Body with Full Element Styling -->
      <div class="article-prose" set:html={article.content}>
      </div>

      <!-- Article End Author Bio & Practice Growth Banner -->
      <div class="mt-16 rounded-2xl overflow-hidden border border-white/10 shadow-2xl bg-neutral-900 group">
        <a href="/#contact" class="block transition-transform duration-300 hover:scale-[1.005]" title="Request Your Free Practice Audit - Seelutions">
          <img
            src="/images/seelution_Author.png"
            alt="Langley Holland, President of Seelutions - Ready to Capture GLP-1 Demand? Call (804) 707-5821"
            class="w-full h-auto object-cover rounded-2xl block"
            loading="lazy"
          />
        </a>
      </div>

      <!-- Practice Territory Call To Action -->
      <div class="mt-12 p-8 sm:p-10 rounded-3xl bg-gradient-to-b from-neutral-900 to-black border border-cyan-500/30 text-center relative overflow-hidden shadow-2xl">
        <div class="absolute top-0 right-1/2 translate-x-1/2 w-96 h-96 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none"></div>
        <div class="relative z-10 max-w-lg mx-auto">
          <span class="inline-block text-[11px] font-bold uppercase tracking-wider px-3 py-1 rounded-full bg-cyan-950 border border-cyan-500/40 text-cyan-300 mb-4">
            Exclusive Territory Partnership
          </span>
          <h3 class="text-2xl sm:text-3xl font-bold font-urbanist text-white mb-3">
            Secure Your Surgical Metropolitan Market
          </h3>
          <p class="text-xs sm:text-sm text-neutral-400 mb-6 leading-relaxed">
            We partner with only one board-certified surgeon per metropolitan territory to prevent internal conflict of interest. Check market availability today.
          </p>
          <Button href="/#contact" variant="black" showIcon={true} class="justify-center mx-auto">
            Request Territory Availability Audit
          </Button>
        </div>
      </div>

      <!-- Related Articles Section -->
      {relatedArticles.length > 0 && (
        <section class="mt-20 pt-12 border-t border-white/10">
          <div class="flex items-center justify-between mb-8">
            <div>
              <h2 class="text-2xl font-bold font-urbanist text-white">Recommended Reading</h2>
              <p class="text-xs text-neutral-400">Continue exploring high-impact surgical practice acquisition insights.</p>
            </div>
            <a href="/blog" class="text-xs font-semibold text-cyan-400 hover:text-cyan-300 transition-colors">
              View All &rarr;
            </a>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {relatedArticles.map((rel) => (
              <a
                href={`/blog/${rel.slug}`}
                class="group block bg-neutral-900/40 hover:bg-neutral-900/80 border border-white/10 hover:border-cyan-500/40 rounded-2xl overflow-hidden transition-all duration-300 flex flex-col justify-between p-4"
              >
                <div>
                  {rel.image && (
                    <div class="aspect-[16/10] rounded-xl overflow-hidden mb-4 bg-neutral-800">
                      <img
                        src={rel.image}
                        alt={rel.title}
                        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                      />
                    </div>
                  )}
                  <span class="text-[10px] font-semibold text-cyan-300 uppercase tracking-wider block mb-2">
                    {rel.category}
                  </span>
                  <h3 class="text-sm font-bold text-white group-hover:text-cyan-300 transition-colors line-clamp-2 leading-snug mb-2 font-urbanist">
                    {rel.title}
                  </h3>
                  <p class="text-xs text-neutral-400 line-clamp-2 leading-relaxed mb-4">
                    {rel.excerpt}
                  </p>
                </div>
                <div class="text-[11px] font-semibold text-cyan-400 flex items-center gap-1 group-hover:translate-x-1 transition-transform">
                  <span>Read Post</span>
                  <span>&rarr;</span>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}
    </div>
  </article>

  <script>
    const copyBtn = document.getElementById("copy-article-link");
    const copyText = document.getElementById("copy-text");

    if (copyBtn && copyText) {
      copyBtn.addEventListener("click", () => {
        if (navigator.clipboard) {
          navigator.clipboard.writeText(window.location.href);
          copyText.textContent = "Link Copied!";
          setTimeout(() => {
            copyText.textContent = "Share Article";
          }, 2500);
        }
      });
    }
  </script>
</BaseLayout>

