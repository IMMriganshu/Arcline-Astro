---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionLabel from "../components/SectionLabel.astro";
import Button from "../components/Button.astro";
import ProjectCTA from "../components/ProjectCTA.astro";
import TestimonialSection from "../components/TestimonialSection.astro";

export const prerender = true;

const pageTitle = "Case Study: 10 Years With Dr. Diepenbrock | seelutions";
const pageDescription = "How Diepenbrock Facial Cosmetic Surgery in Fort Wayne, Indiana grew to #1 on Google with seelutions: website, Google Maps, and AI search.";

const storyPanels = [
  {
    year: "2016",
    title: "Built to be found",
    text: "We built his website and a local search plan around his core facial procedures: facelift and rhinoplasty.",
    linkText: "Learn about Web Design",
    href: "/services/web-design-conversion-optimization/",
    image: "/assets/aistudio/Case_Study_1_8f4e3ed6.jpg"
  },
  {
    year: "2018",
    title: "Proof on every page",
    text: "We added a dedicated page for each procedure and before-and-after galleries that patients could easily browse.",
    linkText: "Learn about Web Design",
    href: "/services/web-design-conversion-optimization/",
    image: "/assets/aistudio/Case_Study_2_ecb9b351.jpg"
  },
  {
    year: "2021",
    title: "On the map",
    text: "We strengthened his Google profile, reviews, and local pages so he showed up when patients searched nearby.",
    linkText: "Learn about Local SEO",
    href: "/services/local-seo-google-maps/",
    image: "/assets/aistudio/Case_Study_3_23e0540a.jpg"
  },
  {
    year: "2024",
    title: "Found on ChatGPT",
    text: "We built expert content and verified credentials for AI tools. Today, new patients tell his team they found him on ChatGPT.",
    linkText: "Learn about AI search",
    href: "/services/ai-search-overviews/",
    image: "/assets/aistudio/Case_Study_4_dfaec931.jpg"
  },
  {
    year: "TODAY",
    title: "#1 in Fort Wayne",
    text: "His practice ranks #1 on Google in Fort Wayne for the searches patients use most when choosing a facial cosmetic surgeon.",
    linkText: null,
    href: null,
    image: "/assets/aistudio/Case_Study_5_76c2a683.jpg"
  }
];

const rankings = [
  "facial cosmetic surgeon",
  "facial plastic surgeon",
  "rhinoplasty surgeon",
  "neck lift specialist",
  "facelift and necklift specialist near me",
  "best facial cosmetic surgeon near me",
  "chin and cheek implant surgeon near me"
];
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <!-- Section C: Top Section (Hero) -->
  <section class="pt-32 pb-16 md:pt-40 md:pb-24 bg-white relative overflow-hidden">
    <div class="max-w-[1440px] mx-auto px-4 sm:px-8 lg:px-12">
      <div class="mb-4" data-animate="fade-up-sm">
        <SectionLabel text="CASE STUDY" />
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
        {/* Left: Heading & Copy */}
        <div class="lg:col-span-7 flex flex-col justify-center">
          <h1 data-animate="fade-up" class="text-3xl sm:text-4xl md:text-5xl lg:text-[3.25rem] font-bold tracking-tight text-[#030303] leading-[1.12] mb-6 font-urbanist">
            10 Years With Dr. Diepenbrock
          </h1>

          <p data-animate="fade-up-sm" data-animate-delay="1" class="text-lg sm:text-xl font-medium text-neutral-800 leading-relaxed mb-8 max-w-2xl">
            How Diepenbrock Facial Cosmetic Surgery in Fort Wayne, Indiana kept growing as the way patients search kept changing: from a new website, to Google Maps, to AI search, to #1 in Fort Wayne.
          </p>

          <div data-animate="fade-up-sm" data-animate-delay="2" class="flex flex-wrap items-center gap-4">
            <Button href="https://audit.seelutions.com/" variant="black" showIcon={true} iconType="arrow-right">
              Get Your Practice Visibility Audit
            </Button>
            <Button href="/schedule-a-call" variant="outline" showIcon={false}>
              Schedule a Call
            </Button>
          </div>
        </div>

        {/* Right: Navy Facts Box */}
        <div class="lg:col-span-5" data-animate="scale-in">
          <div class="relative bg-[#051329] text-white rounded-3xl p-7 sm:p-9 shadow-2xl border border-white/10 overflow-hidden">
            <div class="absolute -top-12 -right-12 w-48 h-48 bg-[#C5A880]/15 rounded-full blur-2xl pointer-events-none"></div>

            <div class="flex items-center gap-4 mb-8">
              <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-full border-[1.5px] border-[#C5A880] p-1 shrink-0 overflow-hidden">
                <img
                  src="/assets/aistudio/Dr._Diepenbrock_162f955f.jpg"
                  alt="Dr. Ryan M. Diepenbrock"
                  class="w-full h-full object-cover rounded-full"
                />
              </div>
              <div>
                <h3 class="text-lg sm:text-xl font-bold text-white font-urbanist">Dr. Ryan M. Diepenbrock</h3>
                <p class="text-xs text-[#C5A880] font-bold tracking-wider uppercase">DDS, FAACS · Fort Wayne, IN</p>
              </div>
            </div>

            <div class="space-y-6">
              <div class="flex flex-col border-b border-white/10 pb-5">
                <span class="text-3xl sm:text-4xl font-bold text-[#C5A880] font-urbanist mb-1">10+ years</span>
                <span class="text-sm text-neutral-300 font-medium">working together</span>
              </div>
              <div class="flex flex-col border-b border-white/10 pb-5">
                <span class="text-3xl sm:text-4xl font-bold text-[#C5A880] font-urbanist mb-1">#1</span>
                <span class="text-sm text-neutral-300 font-medium">on Google in Fort Wayne for 7 tracked searches</span>
              </div>
              <div class="flex flex-col">
                <span class="text-3xl sm:text-4xl font-bold text-[#C5A880] font-urbanist mb-1">ChatGPT</span>
                <span class="text-sm text-neutral-300 font-medium">new patients tell his team they found him there</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section D: The Story (Five Panels) -->
  <section class="py-16 md:py-24 bg-neutral-50 border-t border-b border-neutral-200/80">
    <div class="max-w-[1440px] mx-auto px-4 sm:px-8 lg:px-12">
      <div class="mb-16 text-center max-w-3xl mx-auto">
        <div class="mb-3" data-animate="fade-up-sm">
          <SectionLabel text="THE STORY" />
        </div>
        <h2 data-animate="fade-up" class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-[#030303] font-urbanist">
          A decade of growth, step by step
        </h2>
      </div>

      <div class="space-y-20 md:space-y-32">
        {storyPanels.map((panel, idx) => (
          <div class="group" data-animate="fade-up">
            <div class="relative overflow-hidden rounded-3xl shadow-xl mb-8 border border-neutral-200">
              <img
                src={panel.image}
                alt={`${panel.year}: ${panel.title}`}
                class="w-full h-auto aspect-[16/9] md:aspect-[21/9] object-cover transition-transform duration-700 group-hover:scale-102"
              />
            </div>
            <div class="max-w-3xl">
              <div class="flex items-center gap-4 mb-3">
                <span class="px-3 py-1 rounded-full bg-amber-100/70 text-[#C5A880] font-bold text-xs tracking-wider uppercase">
                  {panel.year}
                </span>
                <h3 class="text-2xl sm:text-3xl font-bold text-[#030303] font-urbanist">{panel.title}</h3>
              </div>
              <p class="text-lg text-neutral-700 leading-relaxed mb-6">
                {panel.text}
              </p>
              {panel.linkText && (
                <a
                  href={panel.href}
                  class="inline-flex items-center gap-2 text-sm font-bold text-[#051329] hover:text-[#C5A880] transition-colors group/link"
                >
                  <span>{panel.linkText}</span>
                  <svg class="w-4 h-4 transition-transform group-hover/link:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                  </svg>
                </a>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Section E: Rankings Box (Navy) -->
  <section class="py-16 md:py-24 bg-white">
    <div class="max-w-[1440px] mx-auto px-4 sm:px-8 lg:px-12">
      <div class="bg-[#051329] rounded-3xl p-8 sm:p-12 md:p-16 relative overflow-hidden shadow-2xl">
        <div class="absolute -bottom-24 -left-24 w-64 h-64 bg-[#C5A880]/10 rounded-full blur-3xl"></div>
        <div class="absolute -top-24 -right-24 w-64 h-64 bg-[#1D60C8]/10 rounded-full blur-3xl"></div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
          <div class="space-y-6">
            <div data-animate="fade-up-sm">
              <SectionLabel text="WHERE HE RANKS TODAY" theme="dark" />
            </div>
            <h2 data-animate="fade-up" class="text-3xl sm:text-4xl md:text-5xl font-bold text-white font-urbanist leading-tight">
              #1 in Fort Wayne
            </h2>
            <p data-animate="fade-up-sm" data-animate-delay="1" class="text-lg text-neutral-300 leading-relaxed max-w-md">
              Searches where Diepenbrock Facial Cosmetic Surgery ranks #1 on Google in Fort Wayne, on desktop and mobile.
            </p>
            <p class="text-[10px] text-neutral-500 font-mono tracking-wider uppercase">
              Source: Keyword.com rank tracking, November 2026.
            </p>
          </div>

          <div class="space-y-3" data-animate="fade-up-sm" data-animate-delay="2">
            {rankings.map((kw) => (
              <div class="flex items-center justify-between p-4 rounded-xl bg-white/5 border border-white/10 hover:bg-white/10 transition-colors">
                <span class="text-white font-medium text-sm sm:text-base">{kw}</span>
                <span class="shrink-0 px-2 py-1 rounded bg-[#C5A880] text-[#051329] text-[10px] font-black uppercase tracking-tight">
                  #1
                </span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section F: His Quote and Video -->
  <TestimonialSection />

  <!-- Section G: Bottom of the page -->
  <ProjectCTA />
</BaseLayout>
