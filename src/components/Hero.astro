---
import Button from "./Button.astro";
---

<section id="hero" class="home-hero">
  <div class="max-w-[1440px] mx-auto px-4 sm:px-8 lg:px-12">
    <div class="home-hero__wrapper">
      <!-- Title with continuous looping video-through-text mask effect -->
      <div class="home-hero__title-wrapper" id="hero-title-wrapper">
        <div class="home-hero__video-bg" aria-hidden="true">
          <video
            id="hero-title-video"
            autoplay
            loop
            muted
            playsinline
            preload="auto"
            class="home-hero__video"
          >
            <source src="/videos/title-video.mp4" type="video/mp4" />
          </video>
        </div>

        <div class="home-hero__title-block">
          <div class="home-hero__title-container">
            <h1 class="home-hero__title font-urbanist" aria-label="BE SEEN BE CHOSEN">
              <!-- Line 1: BE SEEN + Outline Icon Inline -->
              <div class="home-hero__row">
                <span class="home-hero__line">
                  <span class="home-hero__word">
                    <span class="home-hero__letter-block"><span class="home-hero__letter" data-hero-letter="1">B</span></span>
                    <span class="home-hero__letter-block"><span class="home-hero__letter" data-hero-letter="2">E</span></span>
                  </span>
                  <span class="home-hero__space">&nbsp;</span>
                  <span class="home-hero__word">
                    <span class="home-hero__letter-block"><span class="home-hero__letter" data-hero-letter="3">S</span></span>
                    <span class="home-hero__letter-block"><span class="home-hero__letter" data-hero-letter="4">E</span></span>
                    <span class="home-hero__letter-block"><span class="home-hero__letter" data-hero-letter="5">E</span></span>
                    <span class="home-hero__letter-block"><span class="home-hero__letter" data-hero-letter="6">N</span></span>
                  </span>
                </span>

                <!-- Official Seelutions Icon -->
                <span class="home-hero__icon-box" aria-hidden="true">
                  <svg
                    viewBox="0 0 100 100"
                    class="home-hero__icon-svg"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <!-- Video Pass-Through Chamber 1 (Top-Left) -->
                    <path
                      d="M 5 68 C 32 66, 52 44, 95 22 L 95 23 A 18 18 0 0 0 77 5 L 23 5 A 18 18 0 0 0 5 23 Z"
                      fill="#000000"
                    />
                    <!-- Video Pass-Through Chamber 2 (Bottom-Right) -->
                    <path
                      d="M 5 80 C 35 78, 55 56, 95 34 L 95 77 A 18 18 0 0 1 77 95 L 23 95 A 18 18 0 0 1 5 77 Z"
                      fill="#000000"
                    />
                    <!-- Outer Rounded Frame Stroke -->
                    <rect
                      x="5"
                      y="5"
                      width="90"
                      height="90"
                      rx="18"
                      fill="none"
                      stroke="#0e1732"
                      stroke-width="7"
                      stroke-linejoin="round"
                    />
                    <!-- S-Curve Wave Strokes -->
                    <path
                      d="M 5 68 C 32 66, 52 44, 95 22"
                      fill="none"
                      stroke="#0e1732"
                      stroke-width="6"
                      stroke-linecap="round"
                    />
                    <path
                      d="M 5 80 C 35 78, 55 56, 95 34"
                      fill="none"
                      stroke="#0e1732"
                      stroke-width="6"
                      stroke-linecap="round"
                    />
                  </svg>
                </span>
              </div>

              <!-- Line 2: BE CHOSEN -->
              <div class="home-hero__row">
                <span class="home-hero__line">
                  <span class="home-hero__word">
                    <span class="home-hero__letter-block"><span class="home-hero__letter" data-hero-letter="7">B</span></span>
                    <span class="home-hero__letter-block"><span class="home-hero__letter" data-hero-letter="8">E</span></span>
                  </span>
                  <span class="home-hero__space">&nbsp;</span>
                  <span class="home-hero__word">
                    <span class="home-hero__letter-block"><span class="home-hero__letter" data-hero-letter="9">C</span></span>
                    <span class="home-hero__letter-block"><span class="home-hero__letter" data-hero-letter="10">H</span></span>
                    <span class="home-hero__letter-block"><span class="home-hero__letter" data-hero-letter="11">O</span></span>
                    <span class="home-hero__letter-block"><span class="home-hero__letter" data-hero-letter="12">S</span></span>
                    <span class="home-hero__letter-block"><span class="home-hero__letter" data-hero-letter="13">E</span></span>
                    <span class="home-hero__letter-block"><span class="home-hero__letter" data-hero-letter="14">N</span></span>
                  </span>
                </span>
              </div>
            </h1>
          </div>
        </div>
      </div>

      <!-- Full-Width Hero Banner with Overlaid Content on Right (Matching Reference Image) -->
      <div class="hero-banner-card relative rounded-2xl md:rounded-3xl overflow-hidden shadow-2xl border border-white/10 my-4" id="hero-banner" data-hero-animate>
        <!-- Background Image -->
        <div class="absolute inset-0 w-full h-full z-0">
          <img
            id="hero-banner-img"
            src="/images/home-hero-image.webp?v=5"
            alt="Specialized bionic eyeball digital aesthetic for medical and surgical practices"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="w-full h-full object-cover object-left"
          />
          <!-- Gradient overlay on right side to ensure text readability -->
          <div class="absolute inset-0 bg-gradient-to-r from-transparent via-[#050b1a]/60 to-[#030712]/90 lg:from-transparent lg:via-[#050b1a]/50 lg:to-[#030712]/85"></div>
        </div>

        <!-- Content Container (Grid layout with text on right) -->
        <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 min-h-[520px] lg:min-h-[580px] p-6 sm:p-10 lg:p-14 items-center">
          <!-- Left side empty to let the eyeball image breathe -->
          <div class="hidden lg:block lg:col-span-5"></div>

          <!-- Right side content overlaid on the blue background -->
          <div class="lg:col-span-7 flex flex-col justify-center text-white">
            <!-- Eyebrow Tag -->
            <div class="text-[11px] sm:text-xs font-semibold tracking-[0.2em] uppercase text-cyan-300 mb-3 select-none opacity-90">
              SPECIALIZED PATIENT ACQUISITION FOR PLASTIC & FACIAL COSMETIC SURGEONS
            </div>

            <!-- Main Headline -->
            <h2 class="text-3xl sm:text-4xl xl:text-5xl font-extrabold tracking-tight text-white mb-4 font-urbanist leading-[1.15]">
              Be Seen in Search. Be Chosen by High-Ticket Patients.
            </h2>

            <!-- Subheadline Paragraph -->
            <p class="text-neutral-200 text-sm sm:text-base leading-relaxed mb-8 max-w-xl">
              Stop renting $35 clicks. We engineer long-term search authority, Google Map Pack dominance, and AI search visibility that keeps board-certified surgical calendars booked—predictably and organically.
            </p>

            <!-- Call to Action Buttons -->
            <div class="flex flex-wrap items-center gap-4">
              <a
                href="#contact"
                class="inline-flex items-center gap-3 px-7 py-4 rounded-full bg-gradient-to-r from-cyan-500 via-blue-500 to-indigo-600 text-white font-semibold text-sm sm:text-base shadow-[0_0_25px_rgba(6,182,212,0.4)] hover:shadow-[0_0_35px_rgba(6,182,212,0.6)] transition-all duration-300 hover:scale-[1.02] group"
              >
                <span>Get Your Free 3-Minute Practice Audit</span>
                <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                </svg>
              </a>
              <a
                href="#case-studies"
                class="inline-flex items-center gap-2 px-6 py-4 rounded-full bg-white/10 hover:bg-white/15 border border-white/20 text-white font-semibold text-sm sm:text-base backdrop-blur-md transition-all duration-300 hover:scale-[1.02]"
              >
                <span>View the 10-Year Practice Case Study</span>
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Vertical Scroll Indicator Line -->
      <div class="home-hero__scroll-indicator" aria-hidden="true" data-animate="fade-up-sm">
        <div class="home-hero__scroll-line"></div>
      </div>
    </div>
  </div>
</section>

<style>
  .home-hero {
    padding-top: 130px;
    padding-bottom: 24px;
    overflow: hidden;
    position: relative;
    background-color: var(--bg-page, #FCFCFC);
  }

  .home-hero__wrapper {
    flex-direction: column;
    display: flex;
  }

  .home-hero__title-wrapper {
    margin-bottom: 24px;
    position: relative;
    overflow: hidden;
    border-radius: 12px;
  }

  .home-hero__video-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  .home-hero__video {
    object-fit: cover;
    object-position: center 30%;
    width: 100%;
    height: 100%;
    display: block;
  }

  .home-hero__title-block {
    background-color: var(--bg-page, #FCFCFC);
    color: #000000;
    mix-blend-mode: lighten;
    justify-content: center;
    align-items: center;
    display: flex;
    position: relative;
    z-index: 1;
    padding: 10px 0;
    user-select: none;
    width: 100%;
  }

  .home-hero__title-container {
    display: inline-flex;
    justify-content: center;
    align-items: center;
  }

  .home-hero__title {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    margin: 0;
    font-size: clamp(48px, 11.8vw, 195px);
    font-weight: 900;
    line-height: 0.92;
    letter-spacing: -0.04em;
    row-gap: 0.04em;
  }

  .home-hero__row {
    display: inline-flex;
    align-items: center;
    justify-content: flex-start;
    white-space: nowrap;
    gap: 0.25em;
  }

  .home-hero__line {
    display: inline-flex;
    align-items: center;
    justify-content: flex-start;
    white-space: nowrap;
  }

  .home-hero__word {
    display: inline-flex;
    align-items: center;
  }

  .home-hero__space {
    display: inline-block;
  }

  .home-hero__icon-box {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 0.88em;
    width: 0.88em;
    flex-shrink: 0;
    position: relative;
    vertical-align: middle;
    margin-left: 0.05em;
    animation: heroIconReveal 0.85s cubic-bezier(0.16, 1, 0.3, 1) 0.2s backwards;
  }

  @keyframes heroIconReveal {
    from {
      opacity: 0;
      transform: scale(0.8) translateY(18px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  .home-hero__icon-svg {
    width: 100%;
    height: 100%;
    display: block;
    overflow: visible;
  }

  @media screen and (min-width: 1280px) {
    .home-hero__title {
      font-size: 195px;
    }
    .home-hero__title-wrapper {
      margin-bottom: 30px;
    }
  }

  @media screen and (min-width: 1536px) {
    .home-hero__title {
      font-size: 215px;
    }
  }

  .home-hero__letter-block {
    overflow: hidden;
    display: inline-flex;
  }

  .home-hero__letter {
    display: inline-block;
    will-change: transform;
    text-shadow: 0 0 1px rgba(0, 0, 0, 0.12);
  }

  .hero-banner-card {
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hero-banner-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 35px 60px -15px rgba(6, 182, 212, 0.25);
  }

  /* Vertical Scroll Indicator Line */
  .home-hero__scroll-indicator {
    display: flex;
    justify-content: center;
    margin-top: 16px;
    margin-bottom: 4px;
  }

  .home-hero__scroll-line {
    width: 1px;
    height: 48px;
    background-color: rgba(0, 0, 0, 0.12);
    position: relative;
    overflow: hidden;
  }

  .home-hero__scroll-line::after {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: var(--accent-gold, #C5A880);
    animation: scrollLinePulse 2s ease-in-out infinite;
  }

  @keyframes scrollLinePulse {
    0% {
      transform: translateY(-100%);
    }
    50%, 100% {
      transform: translateY(100%);
    }
  }

  @media screen and (max-width: 991px) {
    .home-hero {
      padding-top: 90px;
      padding-bottom: 8px;
    }
    .home-hero__title-wrapper {
      margin-bottom: 18px;
    }
    .home-hero__title {
      font-size: clamp(38px, 11vw, 90px);
      line-height: 0.92;
    }
    .home-hero__scroll-indicator {
      margin-top: 16px;
      margin-bottom: 0px;
    }
    .home-hero__scroll-line {
      height: 40px;
    }
  }

  @media screen and (max-width: 480px) {
    .home-hero__title {
      font-size: clamp(28px, 9.2vw, 44px);
      letter-spacing: -0.03em;
      row-gap: 0.05em;
    }
    .home-hero__row {
      gap: 0.2em;
    }
    .home-hero__icon-box {
      height: 0.84em;
      width: 0.84em;
    }
  }
</style>

<script>
  // Ensure the title video plays continuously in a loop across all browsers
  const vid = document.getElementById('hero-title-video') as HTMLVideoElement | null;
  if (vid) {
    vid.muted = true;
    const playVideo = () => {
      vid.play().catch(() => {});
    };
    playVideo();
    document.addEventListener('click', playVideo, { once: true });
    document.addEventListener('touchstart', playVideo, { once: true });
  }
</script>
