---
import Button from "./Button.astro";
import { getSiteContent } from "../lib/cmsData";

const content = await getSiteContent();
const hero = content.hero;

const titleLine1 = (hero.titleLine1 || "BE SEEN").trim();
const titleLine2 = (hero.titleLine2 || "BE CHOSEN").trim();

const wordsLine1 = titleLine1.split(/\s+/).filter(Boolean);
const wordsLine2 = titleLine2.split(/\s+/).filter(Boolean);

let letterCounter = 0;
---

<section id="hero" class="home-hero">
  <!-- Full-Width Title with continuous looping video-through-text mask effect spanning across the page -->
  <div class="w-full home-hero__title-wrapper" id="hero-title-wrapper">
    <div class="home-hero__video-bg" aria-hidden="true">
      <video
        id="hero-title-video"
        autoplay
        loop
        muted
        playsinline
        preload="metadata"
        class="home-hero__video"
      >
        <source src={hero.titleVideoUrl || "/videos/title-video.mp4"} type="video/mp4" />
      </video>
    </div>

    <div class="home-hero__title-block">
      <div class="home-hero__title-container">
        <h1 class="home-hero__title font-urbanist" aria-label={`${titleLine1} ${titleLine2}`}>
          <!-- Line 1: Dynamic Line 1 + Outline Icon Inline -->
          <div class="home-hero__row">
            <span class="home-hero__line">
              {wordsLine1.map((word, wIdx) => (
                <>
                  <span class="home-hero__word">
                    {word.split('').map((char) => {
                      letterCounter++;
                      return (
                        <span class="home-hero__letter-block">
                          <span class="home-hero__letter" data-hero-letter={letterCounter}>{char}</span>
                        </span>
                      );
                    })}
                  </span>
                  {wIdx < wordsLine1.length - 1 && <span class="home-hero__space">&nbsp;</span>}
                </>
              ))}
            </span>

            <!-- Official seelutions Icon -->
            <span class="home-hero__icon-box" aria-hidden="true">
              <img
                src="/images/seelutions%20new%20updatedLogo.png"
                alt="seelutions Logo"
                class="w-full h-full object-contain filter grayscale brightness-0"
                width="56"
                height="56"
                loading="eager"
                decoding="async"
              />
            </span>
          </div>

          <!-- Line 2: Dynamic Line 2 -->
          <div class="home-hero__row">
            <span class="home-hero__line">
              {wordsLine2.map((word, wIdx) => (
                <>
                  <span class="home-hero__word">
                    {word.split('').map((char) => {
                      letterCounter++;
                      return (
                        <span class="home-hero__letter-block">
                          <span class="home-hero__letter" data-hero-letter={letterCounter}>{char}</span>
                        </span>
                      );
                    })}
                  </span>
                  {wIdx < wordsLine2.length - 1 && <span class="home-hero__space">&nbsp;</span>}
                </>
              ))}
            </span>
          </div>
        </h1>
      </div>
    </div>
  </div>

  <div class="max-w-[1440px] mx-auto px-4 sm:px-8 lg:px-12">
    <div class="home-hero__wrapper">
      <!-- Full-Width Hero Banner with Overlaid Content on Right -->
      <div class="hero-banner-card sticky top-24 rounded-2xl md:rounded-3xl overflow-hidden shadow-2xl border border-white/10" id="hero-banner" data-hero-animate>
        <!-- Background Video / Image (Fitting Plastic & Facial Cosmetic Surgeon Patient Acquisition) -->
        <div class="absolute inset-0 w-full h-full z-0 overflow-hidden">
          <video
            id="hero-banner-video"
            autoplay
            loop
            muted
            playsinline
            preload="none"
            poster="/images/home-hero-image.webp"
            class="w-full h-full object-cover object-left"
          >
            <source src="/videos/eyeball-showcase.mp4" type="video/mp4" />
          </video>
          <!-- Gradient overlay on right side to ensure text readability -->
          <div class="absolute inset-0 bg-gradient-to-r from-black/50 via-[#050b1a]/80 to-[#030712]/95 lg:from-transparent lg:via-[#050b1a]/50 lg:to-[#030712]/85 pointer-events-none"></div>
        </div>

        <!-- Content Container (Grid layout with text on right) -->
        <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 min-h-[520px] lg:min-h-[580px] p-6 sm:p-10 lg:p-14 items-center">
          <!-- Left side empty to let the eyeball image breathe -->
          <div class="hidden lg:block lg:col-span-5"></div>

          <!-- Right side content overlaid on the blue background -->
          <div class="lg:col-span-7 flex flex-col justify-center text-white">
            <!-- Eyebrow Tag -->
            <div class="text-[11px] sm:text-xs font-semibold tracking-[0.2em] uppercase text-cyan-300 mb-3 select-none opacity-90">
              {hero.eyebrowTag}
            </div>

            <!-- Main Headline -->
            <h2 class="text-4xl sm:text-6xl xl:text-7xl font-extrabold tracking-tight text-white mb-6 pt-8 font-urbanist leading-[1.1]">
              {hero.headline}
            </h2>

            <!-- Subheadline Paragraph -->
            <p class="text-neutral-100 text-base sm:text-base leading-relaxed mb-10 max-w-xl">
              {hero.subheadline}
            </p>

            <!-- Call to Action Buttons -->
            <div class="flex flex-wrap items-center gap-4">
              <a
                href={hero.primaryCtaLink}
                class="inline-flex items-center gap-3 px-7 py-4 rounded-full bg-gradient-to-r from-cyan-500 via-blue-500 to-indigo-600 text-white font-semibold text-sm sm:text-base shadow-[0_0_25px_rgba(6,182,212,0.4)] hover:shadow-[0_0_35px_rgba(6,182,212,0.6)] transition-all duration-300 hover:scale-[1.02] group"
              >
                <span>{hero.primaryCtaText}</span>
                <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                </svg>
              </a>
              <a
                href={hero.secondaryCtaLink}
                class="inline-flex items-center gap-2 px-6 py-4 rounded-full bg-white/10 hover:bg-white/15 border border-white/20 text-white font-semibold text-sm sm:text-base backdrop-blur-md transition-all duration-300 hover:scale-[1.02]"
              >
                <span>{hero.secondaryCtaText}</span>
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Vertical Scroll Indicator Line -->
      <div class="home-hero__scroll-indicator" aria-hidden="true" data-animate="fade-up-sm">
        <div class="home-hero__scroll-line"></div>
      </div>
    </div>
  </div>
</section>

<style>
  .home-hero {
    padding-top: 130px;
    padding-bottom: 24px;
    overflow: hidden;
    position: relative;
    background-color: var(--bg-page, #FCFCFC);
  }

  .home-hero__wrapper {
    flex-direction: column;
    display: flex;
  }

  .home-hero__title-wrapper {
    margin-bottom: 24px;
    position: relative;
    overflow: hidden;
    border-radius: 12px;
  }

  .home-hero__video-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  .home-hero__video {
    object-fit: cover;
    object-position: center 30%;
    width: 100%;
    height: 100%;
    display: block;
  }

  .home-hero__title-block {
    background-color: var(--bg-page, #FCFCFC);
    color: #000000;
    mix-blend-mode: lighten;
    justify-content: center;
    align-items: center;
    display: flex;
    position: relative;
    z-index: 1;
    padding: 10px 0;
    user-select: none;
    width: 100%;
  }

  .home-hero__title-container {
    display: inline-flex;
    justify-content: center;
    align-items: center;
  }

  .home-hero__title {
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    margin: 0;
    font-size: clamp(48px, 11.8vw, 195px);
    font-weight: 900;
    line-height: 0.92;
    letter-spacing: -0.04em;
    row-gap: 0.04em;
  }

  .home-hero__row {
    display: inline-flex;
    align-items: center;
    justify-content: flex-start;
    white-space: nowrap;
    gap: 0.25em;
  }

  .home-hero__line {
    display: inline-flex;
    align-items: center;
    justify-content: flex-start;
    white-space: nowrap;
  }

  .home-hero__word {
    display: inline-flex;
    align-items: center;
  }

  .home-hero__space {
    display: inline-block;
  }

  .home-hero__icon-box {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 0.88em;
    width: 0.88em;
    flex-shrink: 0;
    position: relative;
    vertical-align: middle;
    margin-left: 0.05em;
    animation: heroIconReveal 0.85s cubic-bezier(0.16, 1, 0.3, 1) 0.2s backwards;
  }

  @keyframes heroIconReveal {
    from {
      opacity: 0;
      transform: scale(0.8) translateY(18px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  .home-hero__icon-svg {
    width: 100%;
    height: 100%;
    display: block;
    overflow: visible;
  }

  @media screen and (min-width: 1280px) {
    .home-hero__title {
      font-size: 195px;
    }
    .home-hero__title-wrapper {
      margin-bottom: 30px;
    }
  }

  @media screen and (min-width: 1536px) {
    .home-hero__title {
      font-size: 215px;
    }
  }

  .home-hero__letter-block {
    overflow: hidden;
    display: inline-flex;
  }

  .home-hero__letter {
    display: inline-block;
    will-change: transform;
    text-shadow: 0 0 1px rgba(0, 0, 0, 0.12);
  }

  .hero-banner-card {
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hero-banner-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 35px 60px -15px rgba(6, 182, 212, 0.25);
  }

  /* Vertical Scroll Indicator Line */
  .home-hero__scroll-indicator {
    display: flex;
    justify-content: center;
    margin-top: 16px;
    margin-bottom: 4px;
  }

  .home-hero__scroll-line {
    width: 1px;
    height: 48px;
    background-color: rgba(0, 0, 0, 0.12);
    position: relative;
    overflow: hidden;
  }

  .home-hero__scroll-line::after {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: var(--accent-gold, #C5A880);
    animation: scrollLinePulse 2s ease-in-out infinite;
  }

  @keyframes scrollLinePulse {
    0% {
      transform: translateY(-100%);
    }
    50%, 100% {
      transform: translateY(100%);
    }
  }

  @media screen and (max-width: 991px) {
    .home-hero {
      padding-top: 130px;
      padding-bottom: 8px;
    }
    .home-hero__title-wrapper {
      margin-bottom: 18px;
    }
    .home-hero__title {
      font-size: clamp(38px, 11vw, 90px);
      line-height: 0.92;
    }
    .home-hero__scroll-indicator {
      margin-top: 16px;
      margin-bottom: 0px;
    }
    .home-hero__scroll-line {
      height: 40px;
    }
  }

  @media screen and (max-width: 480px) {
    .home-hero__title {
      font-size: clamp(28px, 9.2vw, 44px);
      letter-spacing: -0.03em;
      row-gap: 0.05em;
    }
    .home-hero__row {
      gap: 0.2em;
    }
    .home-hero__icon-box {
      height: 0.84em;
      width: 0.84em;
    }
  }
</style>

<script>
  // Ensure the title video and hero banner video play continuously in a loop across all browsers
  const vids = [
    document.getElementById('hero-title-video') as HTMLVideoElement | null,
    document.getElementById('hero-banner-video') as HTMLVideoElement | null
  ];

  vids.forEach((vid) => {
    if (vid) {
      vid.muted = true;
      const playVideo = () => {
        vid.play().catch(() => {});
      };
      playVideo();
      document.addEventListener('click', playVideo, { once: true });
      document.addEventListener('touchstart', playVideo, { once: true });
    }
  });
</script>
