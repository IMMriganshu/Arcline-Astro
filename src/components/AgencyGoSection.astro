---
import Button from "./Button.astro";

const cards = [
  {
    title: "AI Search Visibility",
    desc: "Get recommended when patients ask ChatGPT and other AI tools which surgeon to see.",
    href: "/services/ai-search-overviews/",
  },
  {
    title: "Local SEO & Google Maps",
    desc: "Show up on the map when patients search for a surgeon near them.",
    href: "/services/local-seo-google-maps/",
  },
  {
    title: "Web Design & Conversion",
    desc: "Turn the patients who find you into booked consultations.",
    href: "/services/web-design-conversion-optimization/",
  },
  {
    title: "Google Ads & Paid Search",
    desc: "Bring in patients right away while your rankings grow.",
    href: "/services/google-ads-paid-search/",
  },
];
---

<section id="agencygo" class="w-full bg-gradient-to-r from-[#07244c] via-[#0b3368] to-[#061e40] py-16 sm:py-20 md:py-24 relative overflow-hidden text-white border-y border-white/10">
  <!-- Large background watermark on the right -->
  <div class="absolute -right-12 sm:-right-16 md:-right-24 top-1/2 -translate-y-1/2 w-[340px] sm:w-[440px] md:w-[580px] lg:w-[680px] h-[340px] sm:h-[440px] md:h-[580px] lg:h-[680px] opacity-[0.14] pointer-events-none select-none">
    <img
      src="/images/agencygo-gold-icon.png"
      alt=""
      class="w-full h-full object-contain filter brightness-150 contrast-125"
      loading="lazy"
      decoding="async"
    />
  </div>

  <div class="max-w-[1440px] mx-auto px-4 sm:px-8 lg:px-12 relative z-10">
    <!-- Top Row: Logo & Intro -->
    <div class="flex flex-col lg:flex-row lg:items-start justify-between gap-10 mb-14">
      <!-- Left: Gold Circular AgencyGo Emblem -->
      <div class="flex items-center gap-6">
        <div class="shrink-0 w-24 h-24 sm:w-32 sm:h-32 md:w-40 md:h-40">
          <img
            src="/images/agencygo-gold-icon.png"
            alt="AgencyGo Emblem"
            class="w-full h-full object-contain drop-shadow-lg"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div>
          <!-- Logo Wordmark: Agency in bold, Go in normal, small superscript ™ -->
          <div class="inline-flex items-baseline mb-1">
            <span class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-white font-urbanist">Agency</span>
            <span class="text-3xl sm:text-4xl md:text-5xl font-normal tracking-tight text-[#c5a880] font-urbanist">Go</span>
            <sup class="text-xs sm:text-sm text-[#c5a880] font-normal align-super ml-0.5">™</sup>
          </div>
          <p class="text-xs sm:text-sm md:text-base font-medium text-white/80 tracking-wider">
            The System Behind The Growth
          </p>
        </div>
      </div>

      <!-- Right: Heading and Paragraph -->
      <div class="max-w-2xl">
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight text-white mb-4">
          Everything your practice needs, working as one system.
        </h2>
        <p class="text-white/90 text-sm sm:text-base md:text-lg leading-relaxed font-normal">
          <strong class="font-bold text-white">Agency</strong><span class="font-normal text-white">Go</span><sup class="text-xs text-white/90 font-normal">™</sup> is how seelutions runs every service we offer. Instead of separate vendors for your website, Google, ads, and AI search, one team that specializes in surgical practices plans and manages it all together, so each part makes the others stronger.
        </p>
      </div>
    </div>

    <!-- Four Cards Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-12">
      {cards.map((card, idx) => (
        <a
          href={card.href}
          class="group bg-white/5 hover:bg-white/10 border border-white/10 hover:border-[#c5a880]/50 rounded-2xl md:rounded-3xl p-6 sm:p-8 transition-all duration-300 flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center justify-between mb-6">
              <span class="text-xs font-bold tracking-widest px-3 py-1 rounded-full bg-[#c5a880]/20 text-[#c5a880]">
                {String(idx + 1).padStart(2, '0')}
              </span>
              <span class="text-white/60 group-hover:text-white transition-colors">
                →
              </span>
            </div>

            <h3 class="text-lg sm:text-xl font-bold text-white tracking-tight mb-3 group-hover:text-[#c5a880] transition-colors">
              {card.title}
            </h3>

            <p class="text-white/70 text-sm sm:text-base leading-relaxed">
              {card.desc}
            </p>
          </div>
        </a>
      ))}
    </div>

    <!-- Bottom CTA Button -->
    <div class="text-center">
      <a
        href="https://audit.seelutions.com/"
        class="inline-flex items-center gap-2.5 px-8 py-4 rounded-full bg-[#c49a45] hover:bg-[#b38a37] text-white font-semibold text-sm sm:text-base transition-all duration-200 shadow-xl hover:shadow-2xl group"
      >
        <span>Get Your Free Practice Visibility Audit</span>
        <span class="transition-transform duration-200 group-hover:translate-x-1">→</span>
      </a>
    </div>
  </div>
</section>
