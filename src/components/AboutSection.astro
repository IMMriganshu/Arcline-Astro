---
import SectionLabel from "./SectionLabel.astro";
import Button from "./Button.astro";
---

<section id="about" class="pt-6 pb-12 md:pt-16 md:pb-28 relative overflow-hidden">
  <div class="max-w-[1440px] mx-auto px-4 sm:px-8 lg:px-12">
    <!-- Block 1: Main Introduction (Recording 00:11-00:14) -->
    <div class="mb-10 md:mb-28">
      <div class="mb-4" data-animate="fade-up-sm">
        <SectionLabel text="ABOUT US" />
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-16 items-start">
        <!-- Left: Major Statement Heading -->
        <div class="lg:col-span-7">
          <h2 data-animate="fade-up" class="text-3xl sm:text-4xl md:text-5xl lg:text-[3.5rem] font-bold tracking-tight text-[#030303] leading-[1.12]">
            We're a Distinguished Architectural Agency Located in Canada
          </h2>
        </div>

        <!-- Right: Supporting Narrative & Action -->
        <div class="lg:col-span-5 flex flex-col justify-between pt-2">
          <p data-animate="fade-up-sm" data-animate-delay="1" class="text-base sm:text-lg text-[#737373] leading-relaxed mb-6 md:mb-8">
            Architecture Agency embodies a combination of exceptional design, innovation, and commitment to creating meaningful spaces that agency goes beyond stand of time.
          </p>
          <div data-animate="fade-up-sm" data-animate-delay="2">
            <Button href="#services" variant="black" showIcon={true}>
              Explore Now
            </Button>
          </div>
        </div>
      </div>
    </div>

    <!-- Block 2: Agency Heritage & Asymmetric Media Grid (Recording 00:14-00:18) -->
    <div class="pt-2 md:pt-8">
      <div class="mb-4" data-animate="fade-up-sm">
        <SectionLabel text="ABOUT US" />
      </div>

      <!-- Large Editorial Narrative Statement -->
      <div class="max-w-4xl mb-8 md:mb-16">
        <p data-animate="fade-up" class="text-xl sm:text-2xl md:text-3xl lg:text-4xl font-medium text-[#030303] leading-snug">
          In 2010, a group of forward architects founded Arcline Architecture with a simple goal: to turn bold visions into reality. We're known for more than just structures we create experiences.
        </p>
      </div>

      <!-- Asymmetric Dual Photo Layout -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-10 items-end">
        <!-- Photo Left: Warm Luxury Residence at Twilight -->
        <div class="lg:col-span-7" data-animate="scale-in">
          <div class="overflow-hidden rounded-2xl md:rounded-3xl shadow-lg border border-black/5 aspect-[4/3] group">
            <img
              src="https://images.unsplash.com/photo-1600585154526-990dced4db0d?auto=format&fit=crop&w=1200&q=85"
              alt="Two-story luxury modern architectural residence with warm ambient lights at dusk"
              class="w-full h-full object-cover object-center transition-transform duration-700 ease-out group-hover:scale-105"
              loading="lazy"
            />
          </div>
        </div>

        <!-- Photo Right: Contemporary Living Pavilion -->
        <div class="lg:col-span-5" data-animate="scale-in" data-animate-delay="2">
          <div class="overflow-hidden rounded-2xl md:rounded-3xl shadow-lg border border-black/5 aspect-[16/11] group">
            <img
              src="https://images.unsplash.com/photo-1600607687920-4e2a09cf159d?auto=format&fit=crop&w=1000&q=85"
              alt="Modern living room interior with double height ceiling, glass partitions, and sculptural stairs"
              class="w-full h-full object-cover object-center transition-transform duration-700 ease-out group-hover:scale-105"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
