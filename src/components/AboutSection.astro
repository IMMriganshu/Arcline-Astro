---
import SectionLabel from "./SectionLabel.astro";
import Button from "./Button.astro";
import { getAboutContent } from "../lib/cms";

const about = await getAboutContent();
---

<section id="about" class="pt-6 pb-12 md:pt-12 md:pb-20 relative overflow-hidden bg-white">
  <div class="max-w-[1440px] mx-auto px-4 sm:px-8 lg:px-12">
    <!-- About Us Section with 10-Year Practice Case Study -->
    <div class="mb-3" data-animate="fade-up-sm">
      <SectionLabel text={about.badge || "About Us"} />
    </div>

    <!-- Large Editorial Narrative Statement -->
    <div class="max-w-4xl mb-8 md:mb-10">
      <h2 data-animate="fade-up" class="text-3xl sm:text-4xl md:text-5xl lg:text-[3.25rem] font-bold text-[#030303] leading-[1.15] mb-4">
        {about.title}
      </h2>
      <p data-animate="fade-up-sm" data-animate-delay="1" class="text-lg sm:text-xl md:text-2xl font-medium text-neutral-800 leading-relaxed mb-3">
        {about.subtitle}
      </p>
      <p data-animate="fade-up-sm" data-animate-delay="2" class="text-base sm:text-lg text-neutral-600 leading-relaxed">
        {about.description}
      </p>
    </div>

    <!-- 2-Column Layout: Left = Video Testimonial, Right = Growth Timeline Block (Equal Height Alignment) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-stretch">
      
      <!-- Left Column: Video Testimonial Player (Full Height Match) -->
      <div class="lg:col-span-5 flex flex-col" data-animate="scale-in">
        <div class="relative overflow-hidden rounded-2xl md:rounded-3xl shadow-lg border border-neutral-200/80 w-full h-full min-h-[380px] max-h-[520px] bg-neutral-950 flex flex-col justify-center group">
          
          <!-- Video Badge Overlay -->
          <div class="absolute top-4 left-4 z-20 flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-black/75 backdrop-blur-md border border-white/20 text-white text-xs font-semibold shadow-md pointer-events-none">
            <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
            <span>Dr. Diepenbrock Testimonial</span>
          </div>

          <!-- Unmute / Sound Toggle Button Overlay -->
          <button
            id="unmute-testimonial-btn"
            type="button"
            class="absolute top-4 right-4 z-20 flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-black/80 hover:bg-black backdrop-blur-md border border-white/30 text-white text-xs font-bold shadow-lg transition-all cursor-pointer hover:scale-105 active:scale-95"
            aria-label="Toggle sound"
          >
            <span id="sound-icon">🔇</span>
            <span id="sound-text">Unmute</span>
          </button>

          <!-- Video Element (Autoplay, Muted, Perfectly Fitted) -->
          <video
            id="testimonial-video"
            autoplay
            muted
            loop
            playsinline
            controls
            preload="auto"
            poster={about.image || "/images/Eyeball-BC.webp"}
            class="w-full h-full object-cover object-top rounded-2xl md:rounded-3xl bg-neutral-950"
          >
            <source src={about.videoUrl || "/videos/Dr%20Diepenbrock%20Testimonial%20Video.mov"} type="video/quicktime" />
            <source src={about.videoUrl || "/videos/Dr%20Diepenbrock%20Testimonial%20Video.mov"} type="video/mp4" />
            Your browser does not support playing this testimonial video.
          </video>
        </div>
      </div>

      <!-- Right Column: Growth Timeline & Retainer Expansion Block (Full Height Match) -->
      <div class="lg:col-span-7 flex flex-col" data-animate="scale-in" data-animate-delay="2">
        <div class="bg-neutral-50 border border-neutral-200/80 rounded-2xl md:rounded-3xl p-6 sm:p-8 shadow-lg w-full h-full flex flex-col justify-between">
          <div class="mb-5">
            <h3 class="text-xl sm:text-2xl md:text-3xl font-black uppercase tracking-tight text-[#050505] mb-2">
              {about.timelineTitle}
            </h3>
            <p class="text-[#050505]/75 text-xs sm:text-sm leading-relaxed">
              {about.timelineSubtitle}
            </p>
          </div>
          <div class="space-y-3">
            {(about.milestones || []).map((m) => (
              <div class="bg-white px-4 py-3 rounded-xl border border-neutral-200/80 shadow-sm flex flex-col sm:flex-row sm:items-center justify-between gap-2 transition-shadow hover:shadow-md">
                <span class="text-xs font-bold px-3 py-1 rounded-full bg-cyan-100 text-cyan-800 w-fit shrink-0">{m.yearBudget}</span>
                <span class="text-neutral-800 text-xs sm:text-sm font-medium leading-snug text-left sm:text-right">{m.text}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function setupTestimonialVideo() {
    const video = document.getElementById('testimonial-video') as HTMLVideoElement | null;
    const unmuteBtn = document.getElementById('unmute-testimonial-btn');
    const soundIcon = document.getElementById('sound-icon');
    const soundText = document.getElementById('sound-text');

    if (video) {
      // Ensure autoplay muted starts automatically
      video.muted = true;
      video.play().catch(() => {
        // Autoplay handled by browser policy
      });

      if (unmuteBtn) {
        unmuteBtn.addEventListener('click', () => {
          if (video.muted) {
            video.muted = false;
            if (soundIcon) soundIcon.textContent = '🔊';
            if (soundText) soundText.textContent = 'Sound On';
            unmuteBtn.classList.remove('bg-black/80');
            unmuteBtn.classList.add('bg-cyan-600');
          } else {
            video.muted = true;
            if (soundIcon) soundIcon.textContent = '🔇';
            if (soundText) soundText.textContent = 'Unmute';
            unmuteBtn.classList.remove('bg-cyan-600');
            unmuteBtn.classList.add('bg-black/80');
          }
        });
      }

      // Sync sound button state if user interacts with native controls
      video.addEventListener('volumechange', () => {
        if (video.muted || video.volume === 0) {
          if (soundIcon) soundIcon.textContent = '🔇';
          if (soundText) soundText.textContent = 'Unmute';
          if (unmuteBtn) {
            unmuteBtn.classList.remove('bg-cyan-600');
            unmuteBtn.classList.add('bg-black/80');
          }
        } else {
          if (soundIcon) soundIcon.textContent = '🔊';
          if (soundText) soundText.textContent = 'Sound On';
          if (unmuteBtn) {
            unmuteBtn.classList.remove('bg-black/80');
            unmuteBtn.classList.add('bg-cyan-600');
          }
        }
      });
    }
  }

  // Initial setup and re-run on client navigation
  setupTestimonialVideo();
  document.addEventListener('astro:page-load', setupTestimonialVideo);
</script>
