---
import SectionLabel from "./SectionLabel.astro";
import Button from "./Button.astro";
import { servicesData } from "../data/siteData";
---

<section id="services" class="py-10 md:py-24 relative">
  <div class="max-w-[1440px] mx-auto px-4 sm:px-8 lg:px-12">
    <!-- Header Row -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-10 md:mb-20">
      <div>
        <div class="mb-3" data-animate="fade-up-sm">
          <SectionLabel text="SERVICES" />
        </div>
        <h2 data-animate="fade-up" class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-[#030303]">
          Our Selected Services
        </h2>
      </div>

      <div data-animate="fade-up-sm">
        <Button href="/services" variant="black" showIcon={true} iconType="arrow-right">
          See All Services
        </Button>
      </div>
    </div>

    <!-- Services List (Matching Recording 00:19-00:27) -->
    <div class="border-t border-black/10">
      {servicesData.map((service, index) => {
        const isEven = index % 2 === 1;

        return (
          <div data-animate="fade-up" data-animate-delay={String(index + 1)} class="group relative py-8 md:py-16 border-b border-black/10 transition-colors duration-300 hover:bg-neutral-50/50">
            <!-- Giant Faint Background Numeral -->
            <div
              class="absolute right-4 md:right-8 top-1/2 -translate-y-1/2 text-7xl sm:text-8xl md:text-9xl font-black text-black/[0.04] select-none pointer-events-none transition-transform duration-500 group-hover:scale-105"
              aria-hidden="true"
            >
              {service.number}
            </div>

            <div class={`grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center relative z-10 ${isEven ? 'lg:flex-row-reverse' : ''}`}>
              <!-- Layout A (Even indices: Image on Left, Text on Right) -->
              {!isEven ? (
                <>
                  <!-- Thumbnail Image -->
                  <div class="lg:col-span-5 overflow-hidden rounded-2xl shadow-sm border border-black/5 aspect-[4/3] max-w-md">
                    <img
                      src={service.image}
                      alt={service.imageAlt}
                      class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                      loading="lazy"
                    />
                  </div>

                  <!-- Text Block -->
                  <div class="lg:col-span-7 flex flex-col justify-center space-y-4">
                    <span class="text-xs font-bold text-[#C5A880] tracking-widest uppercase">
                      Service {service.number}
                    </span>
                    <h3 class="text-2xl sm:text-3xl md:text-4xl font-bold text-[#030303] group-hover:text-black transition-colors">
                      {service.title}
                    </h3>
                    <p class="text-sm sm:text-base text-[#737373] leading-relaxed max-w-xl">
                      {service.description}
                    </p>
                    <div class="pt-2">
                      <Button href={`/services#${service.title.toLowerCase().replace(/\s+/g, '-')}`} variant="outline" showIcon={true} iconType="arrow-right">
                        Service Details
                      </Button>
                    </div>
                  </div>
                </>
              ) : (
                /* Layout B (Odd indices: Text on Left, Image on Right) */
                <>
                  <!-- Text Block -->
                  <div class="lg:col-span-7 flex flex-col justify-center space-y-4 order-2 lg:order-1">
                    <span class="text-xs font-bold text-[#C5A880] tracking-widest uppercase">
                      Service {service.number}
                    </span>
                    <h3 class="text-2xl sm:text-3xl md:text-4xl font-bold text-[#030303] group-hover:text-black transition-colors">
                      {service.title}
                    </h3>
                    <p class="text-sm sm:text-base text-[#737373] leading-relaxed max-w-xl">
                      {service.description}
                    </p>
                    <div class="pt-2">
                      <Button href={`/services#${service.title.toLowerCase().replace(/\s+/g, '-')}`} variant="outline" showIcon={true} iconType="arrow-right">
                        Service Details
                      </Button>
                    </div>
                  </div>

                  <!-- Thumbnail Image on Right -->
                  <div class="lg:col-span-5 overflow-hidden rounded-2xl shadow-sm border border-black/5 aspect-[4/3] max-w-md order-1 lg:order-2">
                    <img
                      src={service.image}
                      alt={service.imageAlt}
                      class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                      loading="lazy"
                    />
                  </div>
                </>
              )}
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>
