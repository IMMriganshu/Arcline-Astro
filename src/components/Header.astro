---
import Logo from "./Logo.astro";
import Button from "./Button.astro";
---

<header id="site-header" class="fixed top-0 left-0 right-0 z-40 transition-all duration-300 py-4 px-4 sm:px-8">
  <div class="max-w-7xl mx-auto flex items-center justify-between">
    <!-- Brand Logo & Tagline -->
    <div class="flex items-center gap-3">
      <Logo variant="dark" size="md" tagline="be seen. be chosen." />
    </div>

    <!-- Desktop Navigation Pill -->
    <nav class="hidden lg:flex items-center gap-1 bg-[#FCFCFC]/85 backdrop-blur-md px-4 py-2 rounded-full border border-black/8 shadow-xs">
      
      <!-- About -->
      <a href="/#about" class="px-3 py-1.5 text-sm font-medium text-[#030303] hover:text-black/70 transition-colors rounded-full">About</a>

      <!-- Services Dropdown -->
      <div class="relative dropdown-container group">
        <button type="button" class="flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium text-[#030303] hover:text-black/70 transition-colors cursor-pointer rounded-full" aria-expanded="false" aria-haspopup="true">
          <span>Services</span>
          <svg class="w-3.5 h-3.5 text-black/50 transition-transform duration-200 group-hover:rotate-180 group-focus-within:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div class="dropdown-menu absolute top-full left-0 pt-2 w-56 z-50">
          <div class="bg-white rounded-2xl p-2 shadow-xl border border-black/8 backdrop-blur-lg">
            <p class="text-[11px] font-semibold text-[#8DC541] uppercase tracking-wider mb-2 px-3 pt-1">Our Expertise</p>
            {[
              { label: "Local SEO & Maps", href: "/services/local-seo" },
              { label: "AI Search & GEO", href: "/services/ai-search" },
              { label: "Medical Brand Identity", href: "/services/branding" },
              { label: "Surgical Web Design", href: "/services/web-design" },
              { label: "Patient Acquisition & PPC", href: "/services/ppc" },
              { label: "Med Spa Pipelines", href: "/services/med-spa" },
            ].map((item) => (
              <a href={item.href} class="block px-3.5 py-2 text-sm text-[#030303] hover:bg-neutral-100 rounded-xl transition-colors font-medium">
                {item.label}
              </a>
            ))}
          </div>
        </div>
      </div>

      <!-- Case Study -->
      <a href="/case-studies" class="px-3 py-1.5 text-sm font-medium text-[#030303] hover:text-black/70 transition-colors rounded-full">Case Study</a>

      <!-- Patient Grower -->
      <a href="/patient-grower" class="px-3 py-1.5 text-sm font-medium text-[#030303] hover:text-black/70 transition-colors rounded-full">Patient Grower</a>
    </nav>

    <!-- Right: Phone & Request Audit Button -->
    <div class="flex items-center gap-4">
      <a href="tel:8047075821" class="hidden sm:block text-sm font-bold text-[#030303] hover:text-black/70 transition-colors">
        (804) 707-5821
      </a>
      <div class="hidden lg:flex">
        <Button href="#contact" id="header-contact-btn" variant="black" showIcon={true}>
          Request Practice Audit
        </Button>
      </div>

      <!-- Mobile Hamburger Button -->
      <button id="mobile-menu-toggle" type="button" class="lg:hidden flex items-center justify-center w-10 h-10 rounded-full bg-white border border-black/10 text-black shadow-xs cursor-pointer" aria-label="Toggle navigation menu" aria-expanded="false">
        <svg id="hamburger-icon" class="w-5 h-5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16m-7 6h7" />
        </svg>
        <svg id="close-icon" class="w-5 h-5 hidden transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu Drawer (Simplified) -->
  <div id="mobile-nav" class="lg:hidden hidden mt-3 mx-2 bg-white rounded-2xl p-5 shadow-2xl border border-black/8 transition-all">
    <div class="flex flex-col space-y-2">
      <a href="/#about" class="px-3 py-2 text-base font-semibold text-black hover:bg-neutral-50 rounded-xl mobile-nav-link">About</a>
      <a href="/#services" class="px-3 py-2 text-base font-semibold text-black hover:bg-neutral-50 rounded-xl mobile-nav-link">Services</a>
      <a href="/case-studies" class="px-3 py-2 text-base font-semibold text-black hover:bg-neutral-50 rounded-xl mobile-nav-link">Case Study</a>
      <a href="/patient-grower" class="px-3 py-2 text-base font-semibold text-black hover:bg-neutral-50 rounded-xl mobile-nav-link">Patient Grower</a>
      <div class="pt-3">
        <Button href="#contact" variant="black" showIcon={true} class="w-full justify-center">Request Practice Audit</Button>
      </div>
    </div>
  </div>
</header>

<script>
  // Mobile menu interaction
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const mobileNav = document.getElementById('mobile-nav');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');
  const mobileLinks = document.querySelectorAll('.mobile-nav-link');

  if (toggleBtn && mobileNav && hamburgerIcon && closeIcon) {
    toggleBtn.addEventListener('click', () => {
      const isHidden = mobileNav.classList.contains('hidden');
      if (isHidden) {
        mobileNav.classList.remove('hidden');
        hamburgerIcon.classList.add('hidden');
        closeIcon.classList.remove('hidden');
        toggleBtn.setAttribute('aria-expanded', 'true');
      } else {
        mobileNav.classList.add('hidden');
        hamburgerIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
        toggleBtn.setAttribute('aria-expanded', 'false');
      }
    });

    mobileLinks.forEach((link) => {
      link.addEventListener('click', () => {
        mobileNav.classList.add('hidden');
        hamburgerIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
        toggleBtn.setAttribute('aria-expanded', 'false');
      });
    });
  }

  // Header scroll appearance
  const header = document.getElementById('site-header');
  window.addEventListener('scroll', () => {
    if (!header) return;
    if (window.scrollY > 40) {
      header.classList.add('bg-[#FCFCFC]/80', 'backdrop-blur-md', 'shadow-xs');
      header.classList.remove('py-4');
      header.classList.add('py-2.5');
    } else {
      header.classList.remove('bg-[#FCFCFC]/80', 'backdrop-blur-md', 'shadow-xs');
      header.classList.remove('py-2.5');
      header.classList.add('py-4');
    }
  });
</script>
