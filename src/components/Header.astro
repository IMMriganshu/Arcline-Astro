---
import Logo from "./Logo.astro";
import Button from "./Button.astro";
import { getSiteConfig, getNavigation } from "../lib/cms";

const siteConfig = await getSiteConfig();
const navItems = await getNavigation();
const phoneDisplay = siteConfig.phone || "(804) 707-5821";
const phoneClean = phoneDisplay.replace(/[^0-9]/g, '');
const headerCtaText = siteConfig.headerCtaText || "Request Practice Audit";
const headerCtaLink = siteConfig.headerCtaLink || "#contact";
---

<header id="site-header" class="fixed top-0 left-0 right-0 z-40 transition-all duration-300 py-4 px-4 sm:px-8">
  <div class="max-w-7xl mx-auto flex items-center justify-between">
    <!-- Brand Logo & Tagline -->
    <div class="flex items-center gap-3">
      <Logo variant="dark" size="md" tagline="be seen. be chosen." fetchpriority="high" />
    </div>

    <!-- Desktop Navigation Pill (Dynamic from CMS) -->
    <nav class="hidden lg:flex items-center gap-1 bg-[#FCFCFC]/85 backdrop-blur-md px-4 py-2 rounded-full border border-black/8 shadow-xs">
      {navItems.map((item) => (
        <div class="relative group">
          <a
            href={item.href}
            class="px-3 py-1.5 text-sm font-medium text-[#030303] hover:text-black/70 hover:bg-black/5 transition-colors rounded-full flex items-center gap-1"
          >
            {item.label}
            {item.hasDropdown && item.children && item.children.length > 0 && (
              <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            )}
          </a>
          {item.hasDropdown && item.children && item.children.length > 0 && (
            <div class="absolute top-full left-0 mt-2 w-48 bg-white rounded-xl shadow-lg border border-black/10 p-2 hidden group-hover:block z-50">
              {item.children.map((child) => (
                <a
                  href={child.href}
                  class="block px-3 py-2 text-sm font-medium text-[#030303] hover:bg-neutral-50 rounded-lg transition-colors"
                >
                  {child.label}
                </a>
              ))}
            </div>
          )}
        </div>
      ))}
    </nav>

    <!-- Right: Phone & Request Audit Button -->
    <div class="flex items-center gap-4">
      <a href={`tel:${phoneClean}`} class="hidden sm:block text-sm font-bold text-[#030303] hover:text-black/70 transition-colors">
        {phoneDisplay}
      </a>
      <div class="hidden lg:flex">
        <Button href={headerCtaLink} id="header-contact-btn" variant="black" showIcon={true}>
          {headerCtaText}
        </Button>
      </div>

      <!-- Mobile Hamburger Button -->
      <button id="mobile-menu-toggle" type="button" class="lg:hidden flex items-center justify-center w-10 h-10 rounded-full bg-white border border-black/10 text-black shadow-xs cursor-pointer" aria-label="Toggle navigation menu" aria-expanded="false">
        <svg id="hamburger-icon" class="w-5 h-5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16m-7 6h7" />
        </svg>
        <svg id="close-icon" class="w-5 h-5 hidden transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu Drawer (Dynamic from CMS) -->
  <div id="mobile-nav" class="lg:hidden hidden mt-3 mx-2 bg-white rounded-2xl p-5 shadow-2xl border border-black/8 transition-all">
    <div class="flex flex-col space-y-2">
      {navItems.map((item) => (
        <a
          href={item.href}
          class="px-3 py-2 text-base font-semibold text-black hover:bg-neutral-50 rounded-xl mobile-nav-link"
        >
          {item.label}
        </a>
      ))}
      <div class="pt-3">
        <Button href={headerCtaLink} variant="black" showIcon={true} class="w-full justify-center">
          {headerCtaText}
        </Button>
      </div>
    </div>
  </div>
</header>

<script>
  // Mobile menu interaction
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const mobileNav = document.getElementById('mobile-nav');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');
  const mobileLinks = document.querySelectorAll('.mobile-nav-link');

  if (toggleBtn && mobileNav && hamburgerIcon && closeIcon) {
    toggleBtn.addEventListener('click', () => {
      const isHidden = mobileNav.classList.contains('hidden');
      if (isHidden) {
        mobileNav.classList.remove('hidden');
        hamburgerIcon.classList.add('hidden');
        closeIcon.classList.remove('hidden');
        toggleBtn.setAttribute('aria-expanded', 'true');
      } else {
        mobileNav.classList.add('hidden');
        hamburgerIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
        toggleBtn.setAttribute('aria-expanded', 'false');
      }
    });

    mobileLinks.forEach((link) => {
      link.addEventListener('click', () => {
        mobileNav.classList.add('hidden');
        hamburgerIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
        toggleBtn.setAttribute('aria-expanded', 'false');
      });
    });
  }

  // Header scroll appearance
  const header = document.getElementById('site-header');
  window.addEventListener('scroll', () => {
    if (!header) return;
    if (window.scrollY > 40) {
      header.classList.add('bg-[#FCFCFC]/80', 'backdrop-blur-md', 'shadow-xs');
      header.classList.remove('py-4');
      header.classList.add('py-2.5');
    } else {
      header.classList.remove('bg-[#FCFCFC]/80', 'backdrop-blur-md', 'shadow-xs');
      header.classList.remove('py-2.5');
      header.classList.add('py-4');
    }
  });
</script>
