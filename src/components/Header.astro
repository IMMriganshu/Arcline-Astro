---
import Logo from "./Logo.astro";
import Button from "./Button.astro";
import { getSiteConfig, getNavigation } from "../lib/cms";

const siteConfig = await getSiteConfig();
const navItems = await getNavigation();
const phoneDisplay = siteConfig.phone || "(804) 707-5821";
const phoneClean = phoneDisplay.replace(/[^0-9]/g, '');
const headerCtaText = siteConfig.headerCtaText || "Request Practice Audit";
const headerCtaLink = siteConfig.headerCtaLink || "#contact";

const currentPath = Astro.url.pathname;

function normalize(path: string) {
  if (!path) return '';
  const clean = path.split('#')[0].split('?')[0];
  return clean.replace(/\/+$/, '') || '/';
}

const normCurrent = normalize(currentPath);

function isChildActive(childHref: string): boolean {
  if (!childHref) return false;
  // Never highlight anchor links because they point to sections on the same page
  if (childHref.includes('#')) {
    return false;
  }
  const normChild = normalize(childHref);
  if (normChild === '/') {
    return normCurrent === '/';
  }
  return normCurrent === normChild || normCurrent.startsWith(normChild + '/');
}

function isItemActive(item: any): boolean {
  if (!item.href) return false;

  // Never highlight anchor links (e.g. /#about, /#case-studies, #contact) because they jump to sections on the same page
  if (item.href.includes('#')) {
    return false;
  }

  const normItem = normalize(item.href);

  // Exact match for the homepage ("/")
  if (normItem === '/') {
    return normCurrent === '/';
  }

  if (normCurrent === normItem || normCurrent.startsWith(normItem + '/')) {
    return true;
  }

  if (item.children && Array.isArray(item.children)) {
    return item.children.some((child: any) => isChildActive(child.href));
  }

  return false;
}
---

<header id="site-header" class="fixed top-0 left-0 right-0 z-40 transition-all duration-300 py-4 px-4 sm:px-8">
  <div class="max-w-7xl mx-auto flex items-center justify-between">
    <!-- Brand Logo & Tagline -->
    <div class="flex items-center gap-3">
      <Logo variant="dark" size="md" tagline="be seen. be chosen." fetchpriority="high" />
    </div>

    <!-- Desktop Navigation Pill (Dynamic from CMS) -->
    <nav class="hidden lg:flex items-center gap-1 bg-[#FCFCFC]/85 backdrop-blur-md px-4 py-2 rounded-full border border-black/8 shadow-xs">
      {navItems.map((item) => {
        const active = isItemActive(item);
        return (
          <div class="relative group">
            <a
              href={item.href}
              class={
                active
                  ? "px-3.5 py-1.5 text-sm font-semibold text-[#030303] bg-[#EFEFEF] hover:bg-[#EAEAEA] rounded-full flex items-center gap-1 transition-colors"
                  : "px-3.5 py-1.5 text-sm font-medium text-[#030303] hover:text-black/70 hover:bg-black/5 transition-colors rounded-full flex items-center gap-1"
              }
            >
              {item.label}
              {item.hasDropdown && item.children && item.children.length > 0 && (
                <svg class="w-3 h-3 transition-transform group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              )}
            </a>
            {item.hasDropdown && item.children && item.children.length > 0 && (
              <div class="absolute top-full left-0 mt-0 w-max min-w-[220px] bg-white rounded-2xl shadow-xl border border-black/10 p-2.5 hidden group-hover:block z-50">
                {item.children.map((child) => {
                  const childActive = isChildActive(child.href);
                  return (
                    <a
                      href={child.href}
                      class={
                        childActive
                          ? "block px-3.5 py-2 text-sm font-semibold text-[#030303] bg-[#EFEFEF] rounded-xl transition-colors whitespace-nowrap"
                          : "block px-3.5 py-2 text-sm font-medium text-[#030303] hover:bg-neutral-100 rounded-xl transition-colors whitespace-nowrap"
                      }
                    >
                      {child.label}
                    </a>
                  );
                })}
              </div>
            )}
          </div>
        );
      })}
    </nav>

    <!-- Right: Phone & Request Audit Button -->
    <div class="flex items-center gap-4">
      <a href={`tel:${phoneClean}`} class="hidden sm:block text-sm font-bold text-[#030303] hover:text-black/70 transition-colors">
        {phoneDisplay}
      </a>
      <div class="hidden lg:flex">
        <Button href={headerCtaLink} id="header-contact-btn" variant="black" showIcon={true}>
          {headerCtaText}
        </Button>
      </div>

      <!-- Mobile Hamburger Button -->
      <button id="mobile-menu-toggle" type="button" class="lg:hidden flex items-center justify-center w-10 h-10 rounded-full bg-white border border-black/10 text-black shadow-xs cursor-pointer" aria-label="Toggle navigation menu" aria-expanded="false">
        <svg id="hamburger-icon" class="w-5 h-5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16m-7 6h7" />
        </svg>
        <svg id="close-icon" class="w-5 h-5 hidden transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu Drawer (Dynamic from CMS) -->
  <div id="mobile-nav" class="lg:hidden hidden mt-3 mx-2 bg-white rounded-2xl p-5 shadow-2xl border border-black/8 transition-all">
    <div class="flex flex-col space-y-2">
      {navItems.map((item) => {
        const active = isItemActive(item);
        return (
          <div>
            <a
              href={item.href}
              class={
                active
                  ? "block px-3 py-2 text-base font-bold text-black bg-[#EFEFEF] rounded-xl mobile-nav-link"
                  : "block px-3 py-2 text-base font-semibold text-black hover:bg-neutral-50 rounded-xl mobile-nav-link"
              }
            >
              {item.label}
            </a>
            {item.hasDropdown && item.children && item.children.length > 0 && (
              <div class="ml-4 mt-1 space-y-1 border-l-2 border-black/10 pl-3">
                {item.children.map((child) => {
                  const childActive = isChildActive(child.href);
                  return (
                    <a
                      href={child.href}
                      class={
                        childActive
                          ? "block px-3 py-1.5 text-sm font-semibold text-black bg-[#EFEFEF] rounded-lg mobile-nav-link"
                          : "block px-3 py-1.5 text-sm font-medium text-neutral-700 hover:bg-neutral-50 rounded-lg mobile-nav-link"
                      }
                    >
                      {child.label}
                    </a>
                  );
                })}
              </div>
            )}
          </div>
        );
      })}
      <div class="pt-3">
        <Button href={headerCtaLink} variant="black" showIcon={true} class="w-full justify-center">
          {headerCtaText}
        </Button>
      </div>
    </div>
  </div>
</header>

<script>
  // Mobile menu interaction
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const mobileNav = document.getElementById('mobile-nav');
  const hamburgerIcon = document.getElementById('hamburger-icon');
  const closeIcon = document.getElementById('close-icon');
  const mobileLinks = document.querySelectorAll('.mobile-nav-link');

  if (toggleBtn && mobileNav && hamburgerIcon && closeIcon) {
    toggleBtn.addEventListener('click', () => {
      const isHidden = mobileNav.classList.contains('hidden');
      if (isHidden) {
        mobileNav.classList.remove('hidden');
        hamburgerIcon.classList.add('hidden');
        closeIcon.classList.remove('hidden');
        toggleBtn.setAttribute('aria-expanded', 'true');
      } else {
        mobileNav.classList.add('hidden');
        hamburgerIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
        toggleBtn.setAttribute('aria-expanded', 'false');
      }
    });

    mobileLinks.forEach((link) => {
      link.addEventListener('click', () => {
        mobileNav.classList.add('hidden');
        hamburgerIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
        toggleBtn.setAttribute('aria-expanded', 'false');
      });
    });
  }

  // Header scroll appearance
  const header = document.getElementById('site-header');
  window.addEventListener('scroll', () => {
    if (!header) return;
    if (window.scrollY > 40) {
      header.classList.add('bg-[#FCFCFC]/80', 'backdrop-blur-md', 'shadow-xs');
      header.classList.remove('py-4');
      header.classList.add('py-2.5');
    } else {
      header.classList.remove('bg-[#FCFCFC]/80', 'backdrop-blur-md', 'shadow-xs');
      header.classList.remove('py-2.5');
      header.classList.add('py-4');
    }
  });
</script>
