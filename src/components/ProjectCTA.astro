---
import SectionLabel from "./SectionLabel.astro";
import Button from "./Button.astro";
---

<section id="contact-cta" class="py-12 md:py-20 relative overflow-hidden bg-neutral-900 text-white">
  <!-- Atmospheric Dark Architectural Background Image -->
  <div class="absolute inset-0 z-0">
    <img
      src="https://images.unsplash.com/photo-1618221195710-dd6b41faaea6?auto=format&fit=crop&w=2100&q=85"
      alt="Atmospheric modern interior architecture with moody dusk lighting"
      class="w-full h-full object-cover object-center opacity-35"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-black/90 via-black/75 to-black/60"></div>
  </div>

  <div class="relative z-10 max-w-[1440px] mx-auto px-4 sm:px-8 lg:px-12">
    <div class="max-w-3xl">
      <!-- Gold Label -->
      <div class="mb-4" data-animate="fade-up-sm">
        <SectionLabel text="START YOUR PROJECT" theme="dark" />
      </div>

      <!-- Large Question Headline (Recording 00:59-01:02) -->
      <h2 data-animate="fade-up" class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-bold tracking-tight text-white leading-[1.15] mb-6">
        Do You Have Any Ideas About Architecture Project?
      </h2>

      <!-- Subtitle -->
      <p data-animate="fade-up-sm" data-animate-delay="1" class="text-base sm:text-lg text-neutral-300 leading-relaxed mb-8 max-w-2xl font-normal">
        Their ability balance modern design with sustainability resulted in beautiful, functional space that reflects our values. Exploring how architecture can blur the lines between function.
      </p>

      <!-- Action Button -->
      <div data-animate="fade-up-sm" data-animate-delay="2">
        <Button href="#contact" variant="white" showIcon={true} iconType="arrow-right">
          Contact Us
        </Button>
      </div>
    </div>
  </div>
</section>
