---
interface Props {
  href?: string;
  variant?: "black" | "white" | "outline";
  showIcon?: boolean;
  iconType?: "arrow-up-right" | "arrow-right";
  class?: string;
  id?: string;
  type?: "button" | "submit" | "reset";
}

const {
  href,
  variant = "black",
  showIcon = true,
  iconType = "arrow-up-right",
  class: className = "",
  id,
  type = "button",
} = Astro.props;

const variantClasses = {
  black: "btn-pill-black",
  white: "btn-pill-white",
  outline: "btn-pill-outline",
};

const badgeClasses = {
  black: "icon-badge",
  white: "icon-badge-dark",
  outline: "icon-badge",
};

const Tag = href ? "a" : "button";
---

<Tag
  href={href}
  id={id}
  type={href ? undefined : type}
  class={`${variantClasses[variant]} group cursor-pointer inline-flex items-center select-none ${className}`}
>
  <slot />
  {showIcon && (
    <span class={badgeClasses[variant]} aria-hidden="true">
      {iconType === "arrow-up-right" ? (
        <svg class="w-3 h-3 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 19.5l15-15m0 0H8.25m11.25 0v11.25" />
        </svg>
      ) : (
        <svg class="w-3 h-3 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
        </svg>
      )}
    </span>
  )}
</Tag>
