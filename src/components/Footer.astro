---
import Logo from "./Logo.astro";
import SectionLabel from "./SectionLabel.astro";
import { siteConfig, pagesDropdownData } from "../data/siteData";
---

<footer id="contact" class="bg-[#050505] text-white pt-10 md:pt-20 pb-8 relative overflow-hidden">
  <div class="max-w-[1440px] mx-auto px-4 sm:px-8 lg:px-12">
    <!-- Pre-Footer Banner: Work With Us (Matching Recording 01:03) -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 pb-8 md:pb-16 border-b border-white/10">
      <div>
        <div class="mb-3">
          <SectionLabel text="LET'S COLLABORATE" theme="dark" />
        </div>
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-white">
          Work With Us
        </h2>
      </div>

      <div>
        <a
          href={`mailto:${siteConfig.email}`}
          class="text-2xl sm:text-3xl md:text-4xl font-medium text-white hover:text-[#C5A880] transition-colors tracking-tight underline underline-offset-8 decoration-white/20 hover:decoration-[#C5A880]"
        >
          {siteConfig.email}
        </a>
      </div>
    </div>

    <!-- 4-Column Footer Information Grid (Matching Recording 01:04-01:06) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-10 lg:gap-12 py-10 md:py-20 border-b border-white/10">
      <!-- Col 1: Brand Info & Socials -->
      <div class="lg:col-span-4 flex flex-col justify-between">
        <div>
          <div class="mb-6">
            <Logo variant="light" size="lg" />
          </div>
          <p class="text-sm text-neutral-400 leading-relaxed max-w-sm mb-6">
            We take pride in delivering innovative architectural solutions that transform spaces and exceed your expectations.
          </p>
          <span class="inline-block text-xs font-mono tracking-widest text-[#C5A880] mb-6">
            {siteConfig.estYear}
          </span>
        </div>

        <!-- Social Badges: IG, TW, FB, WB -->
        <div class="flex items-center gap-3">
          {["IG", "TW", "FB", "WB"].map((network) => (
            <a
              href="#"
              class="w-9 h-9 rounded-full border border-white/15 bg-white/5 hover:bg-white hover:text-black flex items-center justify-center text-xs font-bold transition-all"
              aria-label={network}
            >
              {network}
            </a>
          ))}
        </div>
      </div>

      <!-- Col 2: Pages -->
      <div class="lg:col-span-2">
        <h3 class="text-sm font-semibold tracking-wider text-white uppercase mb-6">
          Pages
        </h3>
        <ul class="space-y-3 text-sm text-neutral-400">
          <li><a href="/" class="hover:text-white transition-colors">Home Page</a></li>
          <li><a href="/#about" class="hover:text-white transition-colors">About Us</a></li>
          <li><a href="/#services" class="hover:text-white transition-colors">Services</a></li>
          <li><a href="#contact" class="hover:text-white transition-colors">Contact</a></li>
          <li><a href="/#blog" class="hover:text-white transition-colors">Blog</a></li>
        </ul>
      </div>

      <!-- Col 3: Utility Pages -->
      <div class="lg:col-span-3">
        <h3 class="text-sm font-semibold tracking-wider text-white uppercase mb-6">
          Utility Pages
        </h3>
        <ul class="space-y-3 text-sm text-neutral-400">
          <li><a href="/style-guide" class="hover:text-white transition-colors">Style Guide</a></li>
          <li><a href="/style-guide#license" class="hover:text-white transition-colors">License</a></li>
          <li><a href="/style-guide#changelog" class="hover:text-white transition-colors">Changelog</a></li>
          <li><a href="/404" class="hover:text-white transition-colors">Not Found</a></li>
          <li><a href="/style-guide#password" class="hover:text-white transition-colors">Password Protected</a></li>
        </ul>
      </div>

      <!-- Col 4: Address -->
      <div class="lg:col-span-3">
        <h3 class="text-sm font-semibold tracking-wider text-white uppercase mb-6">
          Address
        </h3>
        <address class="not-italic space-y-3 text-sm text-neutral-400">
          <p>
            <a href={`mailto:${siteConfig.email}`} class="hover:text-white transition-colors">
              {siteConfig.email}
            </a>
          </p>
          <p>
            <a href={`tel:${siteConfig.phone.replace(/[^0-9]/g, '')}`} class="hover:text-white transition-colors">
              {siteConfig.phone}
            </a>
          </p>
          <p class="leading-relaxed">
            567 Jac Spruce Crescent<br />
            Montreal, QC H1A 2K3
          </p>
        </address>
      </div>
    </div>

    <!-- Massive Oversized Wordmark Dominating Footer -->
    <div class="pt-8 pb-6 text-center overflow-hidden">
      <p class="footer-massive-text font-urbanist uppercase text-white tracking-tight">
        Arcline
      </p>
    </div>

    <!-- Bottom Copyright & Attributions Bar -->
    <div class="pt-6 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-neutral-400">
      <p>Copyright © 2026</p>
      <p>Designed by Impact Monster</p>
      <p>Powered by Astro</p>
    </div>
  </div>
</footer>
