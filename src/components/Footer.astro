---
import Logo from "./Logo.astro";
import SectionLabel from "./SectionLabel.astro";
import { getSiteConfig, getFooterContent, getNavigation } from "../lib/cms";

const siteConfig = await getSiteConfig();
const footer = await getFooterContent();
const navItems = await getNavigation();

const taglineText = "Helping plastic and cosmetic surgeons get found on Google, Google Maps, and AI search.";
---

<footer id="contact" class="bg-[#050D1D] text-white pt-16 pb-8 border-0">
  <div class="max-w-[1440px] mx-auto px-4 sm:px-8 lg:px-12">
    <!-- 4-Column Footer Information Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 py-10 md:py-20 border-b border-white/10">
      
      <!-- Col 1: Logo, Positioning -->
      <div class="flex flex-col gap-6">
        <Logo variant="light" size="lg" />
        {footer.tagline && footer.tagline.toLowerCase().trim() !== "be seen. be chosen." && (
          <p class="text-xl font-medium tracking-tight">{footer.tagline}</p>
        )}
        <div class="text-sm text-neutral-400 leading-relaxed prose prose-invert prose-sm max-w-none">
          {taglineText}
        </div>
      </div>

      <!-- Col 2: Quick Links (Synced with Navigation) -->
      <div>
        <h3 class="text-sm font-semibold tracking-wider text-white uppercase mb-6">
          Quick Links
        </h3>
        <ul class="space-y-3 text-sm text-neutral-400">
          {navItems.map((item) => {
            const label = (item.label === "Blog" || item.href === "/blog") ? "Patient Grower" : item.label;
            return (
              <li>
                <a href={item.href} class="hover:text-white transition-colors">
                  {label}
                </a>
              </li>
            );
          })}
        </ul>
      </div>

      <!-- Col 3: Contact Details & Address -->
      <div>
        <h3 class="text-sm font-semibold tracking-wider text-white uppercase mb-6">
          Contact
        </h3>
        <address class="not-italic space-y-3 text-sm text-neutral-400">
          <p>
            <a href={`mailto:${siteConfig.email}`} class="hover:text-white transition-colors">
              {siteConfig.email}
            </a>
          </p>
          <p>
            <a href={`tel:${siteConfig.phone.replace(/[^0-9]/g, '')}`} class="hover:text-white transition-colors">
              {siteConfig.phone}
            </a>
          </p>
          <p class="leading-relaxed">
            {siteConfig.address}
          </p>
        </address>
      </div>

      <!-- Col 4: Copyright & Legal Info -->
      <div>
        <h3 class="text-sm font-semibold tracking-wider text-white uppercase mb-6">
          Legal
        </h3>
        <p class="text-sm text-neutral-400 leading-relaxed mb-3">
          {(footer.copyrightText || "© 2026 seelutions. All Rights Reserved.").replace(/Seelutions/g, 'seelutions')}
        </p>
        {footer.disclaimer && (
          <div class="text-xs text-neutral-500 leading-relaxed mb-4 prose prose-invert prose-xs max-w-none" set:html={footer.disclaimer.replace(/Seelutions/g, 'seelutions')} />
        )}
        <div class="pt-2">
          <a
            href="/privacy-policy"
            class="text-xs text-neutral-400 hover:text-[#C5A880] transition-colors underline underline-offset-4"
          >
            Privacy Policy
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>
