---
import Logo from "./Logo.astro";
import SectionLabel from "./SectionLabel.astro";
import { siteConfig, pagesDropdownData } from "../data/siteData";
---

<footer id="contact" class="bg-[#050505] text-white pt-20 pb-8">
  <div class="max-w-[1440px] mx-auto px-4 sm:px-8 lg:px-12">
    <!-- 4-Column Footer Information Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 py-10 md:py-20 border-b border-white/10">
      
      <!-- Col 1: Logo, Tagline, Positioning -->
      <div class="flex flex-col gap-6">
        <Logo variant="light" size="lg" />
        <p class="text-xl font-medium tracking-tight">be seen. be chosen.</p>
        <p class="text-sm text-neutral-400 leading-relaxed">
          Helping surgical practices dominate local and AI-driven search landscapes.
        </p>
      </div>

      <!-- Col 2: Quick Links -->
      <div>
        <h3 class="text-sm font-semibold tracking-wider text-white uppercase mb-6">
          Quick Links
        </h3>
        <ul class="space-y-3 text-sm text-neutral-400">
          <li><a href="/#about" class="hover:text-white transition-colors">About</a></li>
          <li><a href="/#services" class="hover:text-white transition-colors">Services</a></li>
          <li><a href="/#case-study" class="hover:text-white transition-colors">Case Study</a></li>
          <li><a href="/#patient-grower" class="hover:text-white transition-colors">Patient Grower</a></li>
        </ul>
      </div>

      <!-- Col 3: Contact Details & Address -->
      <div>
        <h3 class="text-sm font-semibold tracking-wider text-white uppercase mb-6">
          Contact
        </h3>
        <address class="not-italic space-y-3 text-sm text-neutral-400">
          <p>
            <a href={`mailto:${siteConfig.email}`} class="hover:text-white transition-colors">
              {siteConfig.email}
            </a>
          </p>
          <p>
            <a href={`tel:${siteConfig.phone.replace(/[^0-9]/g, '')}`} class="hover:text-white transition-colors">
              {siteConfig.phone}
            </a>
          </p>
          <p class="leading-relaxed">
            {siteConfig.address}
          </p>
        </address>
      </div>

      <!-- Col 4: Copyright Info -->
      <div>
        <h3 class="text-sm font-semibold tracking-wider text-white uppercase mb-6">
          Legal
        </h3>
        <p class="text-sm text-neutral-400 leading-relaxed mb-4">
          © 2026 seelutions. All Rights Reserved. Patient Grower is a specialized publication of seelutions.
        </p>
        <a
          href="/admin"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white/5 hover:bg-white/10 border border-white/10 text-xs font-medium text-neutral-400 hover:text-cyan-300 transition-colors"
        >
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
          </svg>
          <span>CMS Admin Portal</span>
        </a>
      </div>
    </div>
  </div>
</footer>
