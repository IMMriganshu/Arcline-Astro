---
import SectionLabel from "./SectionLabel.astro";
import { getTestimonials } from "../lib/cms";

const testimonialsData = await getTestimonials();
const testimonial = testimonialsData[0] || {
  quote: "I have no idea what you are doing, but just keep doing it. We are consistently hearing new patients say they found us on ChatGPT when they searched for Plastic Surgeon Near Me.",
  author: "Dr. Ryan Diepenbrock, DDS, FAACS",
  role: "Founder & Chief Facial Cosmetic Surgeon",
  company: "Diepenbrock Facial Cosmetic Surgery",
  avatar: "/assets/aistudio/Dr._Diepenbrock_162f955f.jpg",
};
---

<section id="testimonials" class="py-10 md:py-24 relative bg-white">
  <div class="max-w-[1440px] mx-auto px-4 sm:px-8 lg:px-12">
    <!-- Header -->
    <div class="mb-8 md:mb-14">
      <div class="mb-3" data-animate="fade-up-sm">
        <SectionLabel text="CLIENT TESTIMONIAL" />
      </div>
      <h2 data-animate="fade-up" class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-[#030303]">
        What Our Clients Say
      </h2>
    </div>

    <!-- Single Featured Testimonial Layout (No Border, No Shadow) -->
    <div data-animate="fade-up" class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-14 items-center bg-neutral-50/60 rounded-2xl md:rounded-3xl p-6 sm:p-10 md:p-12">
      
      <!-- Left Column: 5-Star Rating, Quote, Author Info -->
      <div class="lg:col-span-7 flex flex-col justify-between">
        <div>
          <!-- 5 Gold Stars Rating -->
          <div class="flex items-center gap-1.5 text-[#D4AF37] mb-6" aria-label="5 out of 5 stars">
            {Array.from({ length: 5 }).map(() => (
              <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
              </svg>
            ))}
            <span class="ml-2 text-xs font-bold text-neutral-500 uppercase tracking-wider">5.0 Verified Practice Review</span>
          </div>

          <!-- Stylized Quotation Mark -->
          <span class="text-6xl font-serif text-[#C5A880] block mb-2 leading-none" aria-hidden="true">
            “
          </span>

          <!-- Quote text -->
          <blockquote class="text-xl sm:text-2xl md:text-3xl font-bold text-[#030303] leading-relaxed tracking-tight mb-8">
            "{testimonial.quote}"
          </blockquote>

          <!-- Author Info -->
          <div class="pt-4 border-t border-neutral-200">
            <h3 class="text-xl sm:text-2xl font-black text-[#030303] tracking-tight">{testimonial.author}</h3>
            <p class="text-sm sm:text-base font-medium text-[#737373] mt-1">{testimonial.company}</p>
          </div>
        </div>
      </div>

      <!-- Right Column: Dr. Diepenbrock Portrait Image (No Border, No Shadow) -->
      <div class="lg:col-span-5 flex justify-center">
        <div class="relative overflow-hidden rounded-2xl md:rounded-3xl w-full max-w-[420px] bg-neutral-100 group">
          <img
            src={testimonial.avatar}
            alt={`Portrait of ${testimonial.author}`}
            class="w-full h-auto object-cover rounded-2xl md:rounded-3xl transition-transform duration-700 ease-out group-hover:scale-102"
            loading="lazy"
            decoding="async"
            width="800"
            height="800"
          />
        </div>
      </div>
    </div>
  </div>
</section>
