---
import SectionLabel from "./SectionLabel.astro";
---

<section id="comparison" class="py-16 md:py-24 bg-white overflow-hidden">
  <div class="max-w-[1440px] mx-auto px-4 sm:px-8 lg:px-12">
    <!-- Header -->
    <div class="text-center mb-12 md:mb-16">
      <div class="flex justify-center mb-4" data-animate="fade-up-sm">
        <SectionLabel text="Rented Clicks vs. Owned Authority" />
      </div>
      <h2 data-animate="fade-up" class="text-3xl sm:text-4xl md:text-5xl font-black text-[#030303] leading-[1.1] mb-6">
        Why Traditional Models Fail Plastic Surgeons
      </h2>
    </div>

    <!-- Comparison Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      
      <!-- Rented Clicks (Traditional) -->
      <div class="bg-neutral-50 rounded-3xl p-8 border border-neutral-200 transition-all duration-500 hover:shadow-2xl hover:border-neutral-300" data-animate="fade-right">
        <h3 class="text-2xl font-black text-neutral-500 mb-8">Traditional Agencies (Rented Clicks)</h3>
        <div class="space-y-6">
          <div class="p-6 bg-white rounded-2xl border border-neutral-100 shadow-sm transition-all duration-300 hover:shadow-lg hover:border-neutral-200 hover:-translate-y-1">
            <h4 class="font-black text-lg text-neutral-900 mb-2">Rented Clicks</h4>
            <p class="text-neutral-600 text-sm leading-relaxed">Charges $35+ per click on Google Ads that stops generating leads the second ad spend ends.</p>
          </div>
          <div class="p-6 bg-white rounded-2xl border border-neutral-100 shadow-sm transition-all duration-300 hover:shadow-lg hover:border-neutral-200 hover:-translate-y-1">
            <h4 class="font-black text-lg text-neutral-900 mb-2">Generic Templates</h4>
            <p class="text-neutral-600 text-sm leading-relaxed">Uses cookie-cutter websites built for general local businesses, not high-ticket surgical patients.</p>
          </div>
          <div class="p-6 bg-white rounded-2xl border border-neutral-100 shadow-sm transition-all duration-300 hover:shadow-lg hover:border-neutral-200 hover:-translate-y-1">
            <h4 class="font-black text-lg text-neutral-900 mb-2">High Account Churn</h4>
            <p class="text-neutral-600 text-sm leading-relaxed">Practices switch agencies every 9 months due to lack of transparent ROI.</p>
          </div>
        </div>
      </div>

      <!-- seelutions Growth Blueprint -->
      <div class="bg-neutral-900 rounded-3xl p-8 border border-neutral-800 transition-all duration-500 hover:shadow-2xl hover:border-neutral-700" data-animate="fade-left">
        <h3 class="text-2xl font-black text-[#8DC541] mb-8">The Seelutions Growth Blueprint</h3>
        <div class="space-y-6">
          <div class="p-6 bg-neutral-800 rounded-2xl border border-neutral-700 shadow-sm transition-all duration-300 hover:bg-neutral-700 hover:border-neutral-600 hover:-translate-y-1">
            <h4 class="font-black text-lg text-white mb-2">Owned Search Equity</h4>
            <p class="text-neutral-300 text-sm leading-relaxed">Builds organic rankings, local Map Pack dominance, and AI search citations that belong to your practice forever.</p>
          </div>
          <div class="p-6 bg-neutral-800 rounded-2xl border border-neutral-700 shadow-sm transition-all duration-300 hover:bg-neutral-700 hover:border-neutral-600 hover:-translate-y-1">
            <h4 class="font-black text-lg text-white mb-2">High-Ticket Gallery UX</h4>
            <p class="text-neutral-300 text-sm leading-relaxed">Builds specialized procedure hubs for Facelifts, Rhinoplasty, and Body Contouring with GA4-optimized galleries.</p>
          </div>
          <div class="p-6 bg-neutral-800 rounded-2xl border border-neutral-700 shadow-sm transition-all duration-300 hover:bg-neutral-700 hover:border-neutral-600 hover:-translate-y-1">
            <h4 class="font-black text-lg text-white mb-2">Decade-Long Retention</h4>
            <p class="text-neutral-300 text-sm leading-relaxed">Proven track record of scaling practice investment through 10 years of continuous growth.</p>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
