---
import SectionLabel from "./SectionLabel.astro";
import { getComparisonContent } from "../lib/cms";

const comparison = await getComparisonContent();
const badge = comparison.badge || "Rented Clicks vs. Owned Authority";
const headline = comparison.headline || "Why Traditional Models Fail Plastic Surgeons";
const traditionalTitle = comparison.traditionalTitle || "Traditional Agencies (Rented Clicks)";
const traditionalItems = comparison.traditionalItems || [];
const seelutionsTitle = (comparison.seelutionsTitle || "The seelutions Growth Blueprint").replace(/Seelutions/g, 'seelutions');
const seelutionsItems = comparison.seelutionsItems || [];
---

<section id="comparison" class="py-16 md:py-24 bg-white overflow-hidden">
  <div class="max-w-[1440px] mx-auto px-4 sm:px-8 lg:px-12">
    <!-- Header -->
    <div class="text-center mb-12 md:mb-16">
      <div class="flex justify-center mb-4" data-animate="fade-up-sm">
        <SectionLabel text={badge} />
      </div>
      <h2 data-animate="fade-up" class="text-3xl sm:text-4xl md:text-5xl font-black text-[#030303] leading-[1.1] mb-6">
        {headline}
      </h2>
    </div>

    <!-- Comparison Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      
      <!-- Rented Clicks (Traditional) -->
      <div class="bg-neutral-50 rounded-3xl p-8 border border-neutral-200 transition-all duration-500 hover:shadow-2xl hover:border-neutral-300" data-animate="fade-right">
        <h3 class="text-2xl font-black text-neutral-500 mb-8">{traditionalTitle}</h3>
        <div class="space-y-6">
          {traditionalItems.map((item) => (
            <div class="p-6 bg-white rounded-2xl border border-neutral-100 shadow-sm transition-all duration-300 hover:shadow-lg hover:border-neutral-200 hover:-translate-y-1">
              <h4 class="font-black text-lg text-neutral-900 mb-2">{item.title}</h4>
              <p class="text-neutral-600 text-sm leading-relaxed">{item.description}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- seelutions Growth Blueprint -->
      <div class="bg-neutral-900 rounded-3xl p-8 border border-neutral-800 transition-all duration-500 hover:shadow-2xl hover:border-neutral-700" data-animate="fade-left">
        <h3 class="text-2xl font-black text-[#8DC541] mb-8">{seelutionsTitle}</h3>
        <div class="space-y-6">
          {seelutionsItems.map((item) => (
            <div class="p-6 bg-neutral-800 rounded-2xl border border-neutral-700 shadow-sm transition-all duration-300 hover:bg-neutral-700 hover:border-neutral-600 hover:-translate-y-1">
              <h4 class="font-black text-lg text-white mb-2">{item.title}</h4>
              <p class="text-neutral-300 text-sm leading-relaxed">{item.description}</p>
            </div>
          ))}
        </div>
      </div>

    </div>
  </div>
</section>
