---
import SectionLabel from "./SectionLabel.astro";
import Button from "./Button.astro";
import { getArticles } from "../lib/cms";

const rawArticles = await getArticles();
// Exclude injectable/med-spa article from homepage grid and limit strictly to the 3 featured articles
const homepageArticles = rawArticles
  .filter((a: any) => a.published && !a.slug.includes("injectable"))
  .slice(0, 3);
---

<section id="blog" class="py-16 md:py-28 relative bg-[#fff]">
  <div class="max-w-[1440px] mx-auto px-4 sm:px-8 lg:px-12">
    <!-- Header Wording -->
    <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-8 mb-12 md:mb-20">
      <div class="max-w-3xl">
        <div class="mb-3" data-animate="fade-up-sm">
          <SectionLabel text="PATIENT GROWER INSIGHTS" />
        </div>
        <h2 data-animate="fade-up" class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-[#050505] mb-6 leading-tight font-urbanist">
          Marketing Insights for Plastic and Cosmetic Surgeons
        </h2>
        <p data-animate="fade-up" class="text-neutral-600 text-base sm:text-lg leading-relaxed">
          Patient Grower is where we share what we are learning about how patients choose a surgeon today, on Google, Google Maps, and AI tools like ChatGPT. Practical articles written for surgeons and practice managers. No generic blog posts.
        </p>
      </div>

      <div data-animate="fade-up-sm">
        <Button href="/blog" variant="black" showIcon={true} iconType="arrow-right">
          Explore Patient Grower
        </Button>
      </div>
    </div>

    <!-- 3-Column Article Row (Exactly 3 articles side by side on desktop) -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      {homepageArticles.map((article, idx) => (
        <article data-animate="fade-up" data-animate-delay={String(idx + 1)} class="group flex flex-col justify-between h-full bg-[#FAFAFA] border border-neutral-200/70 p-6 sm:p-7 rounded-2xl md:rounded-3xl hover:border-neutral-300 transition-all duration-300 shadow-xs hover:shadow-md">
          <div>
            <!-- Image with zoom hover effect -->
            <a href={`/blog/${article.slug}`} class="block overflow-hidden rounded-xl shadow-xs border border-black/5 aspect-[16/10] mb-6 bg-neutral-100">
              <img
                src={article.image}
                alt={article.title}
                class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                loading="lazy"
                decoding="async"
                width="600"
                height="375"
              />
            </a>

            <!-- Category Badge and Read Time -->
            <div class="flex items-center gap-2.5 text-xs font-semibold tracking-wider text-[#737373] uppercase mb-3">
              <span class="text-[#C5A880] bg-[#C5A880]/10 px-2.5 py-1 rounded-md border border-[#C5A880]/30 font-bold">
                {article.category}
              </span>
              <span aria-hidden="true" class="text-neutral-300">•</span>
              <span>{article.readTime}</span>
            </div>

            <!-- Title -->
            <h3 class="text-xl sm:text-2xl font-bold text-[#050505] group-hover:text-[#C5A880] leading-snug mb-3 transition-colors font-urbanist">
              <a href={`/blog/${article.slug}`} class="hover:underline underline-offset-4 decoration-neutral-300">
                {article.title}
              </a>
            </h3>

            <!-- Excerpt -->
            <div class="text-sm sm:text-base text-neutral-600 leading-relaxed mb-6 prose prose-neutral max-w-none line-clamp-3" set:html={article.excerpt} />
          </div>

          <!-- Bottom Card Footer Link -->
          <a
            href={`/blog/${article.slug}`}
            class="pt-4 border-t border-neutral-200/80 flex items-center justify-between text-sm font-semibold text-[#050505] group-hover:text-[#C5A880] transition-colors cursor-pointer mt-auto"
          >
            <span>Read Article</span>
            <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1 text-[#C5A880]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </a>
        </article>
      ))}
    </div>
  </div>
</section>
