---
import SectionLabel from "./SectionLabel.astro";
import Button from "./Button.astro";
import { blogArticles } from "../data/siteData";
---

<section id="blog" class="py-10 md:py-24 relative">
  <div class="max-w-[1440px] mx-auto px-4 sm:px-8 lg:px-12">
    <!-- Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-8 md:mb-16">
      <div>
        <div class="mb-3" data-animate="fade-up-sm">
          <SectionLabel text="ARTICLES & BLOG" />
        </div>
        <h2 data-animate="fade-up" class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-[#030303]">
          Our Articles & Blog
        </h2>
      </div>

      <div data-animate="fade-up-sm">
        <Button href="/blog" variant="black" showIcon={true} iconType="arrow-right">
          See All Articles
        </Button>
      </div>
    </div>

    <!-- 2-Column Editorial Grid (Matching Recording 00:53-00:58) -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-12">
      {blogArticles.map((article, idx) => (
        <article data-animate="fade-up" data-animate-delay={String(idx + 1)} class="group flex flex-col justify-between">
          <div>
            <!-- Image with zoom hover effect -->
            <div class="overflow-hidden rounded-2xl md:rounded-3xl shadow-md border border-black/5 aspect-[16/10] mb-6 bg-neutral-100">
              <img
                src={article.image}
                alt={article.title}
                class="w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                loading="lazy"
              />
            </div>

            <!-- Clean unboxed metadata with bullet separators -->
            <div class="flex items-center gap-2.5 text-xs font-semibold tracking-wider text-[#737373] uppercase mb-3">
              <span class="text-[#C5A880]">{article.category}</span>
              <span aria-hidden="true" class="text-neutral-300">•</span>
              <span>{article.date}</span>
              <span aria-hidden="true" class="text-neutral-300">•</span>
              <span>{article.readTime}</span>
            </div>

            <!-- Title with hover color change -->
            <h3 class="text-2xl sm:text-3xl font-bold text-[#030303] group-hover:text-black leading-snug mb-3 transition-colors">
              <a href={`/blog#${article.slug}`} class="hover:underline underline-offset-4 decoration-neutral-300">
                {article.title}
              </a>
            </h3>

            <!-- Excerpt -->
            <p class="text-sm sm:text-base text-[#737373] leading-relaxed">
              {article.excerpt}
            </p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
