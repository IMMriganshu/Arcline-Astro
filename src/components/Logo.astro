---
interface Props {
  variant?: "dark" | "light";
  size?: "sm" | "md" | "lg";
  class?: string;
  tagline?: string;
}

const { variant = "dark", size = "md", class: className = "", tagline } = Astro.props;

const isLight = variant === "light";
const textColor = isLight ? "text-white" : "text-[#030303]";
const barBg = isLight ? "bg-white" : "bg-[#030303]";

const iconSizes = {
  sm: "h-6 w-6",
  md: "h-8 w-8",
  lg: "h-10 w-10",
};

const textSizes = {
  sm: "text-lg",
  md: "text-xl",
  lg: "text-2xl",
};
---

<a href="/" class={`inline-flex items-center gap-3 group select-none ${className}`}>
  <!-- New logo -->
  <div class={iconSizes[size]}>
    <img src="/images/seelutions-favicon.png" alt="Seelutions Logo" class="w-full h-full object-contain" />
  </div>
  <div class="flex flex-col">
    <span class={`font-bold tracking-tight ${textColor} ${textSizes[size]}`}>
      Seelutions
    </span>
    {tagline && <span class="text-[10px] font-medium text-neutral-500 uppercase tracking-wide -mt-0.5">{tagline}</span>}
  </div>
</a>
