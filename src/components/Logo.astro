---
interface Props {
  variant?: "dark" | "light";
  size?: "sm" | "md" | "lg";
  class?: string;
  tagline?: string;
  fetchpriority?: "high" | "low" | "auto";
}

const { variant = "dark", size = "md", class: className = "", tagline, fetchpriority = "auto" } = Astro.props;

const isLight = variant === "light";
const textColor = isLight ? "text-white" : "text-[#030303]";

const iconSizes = {
  sm: "h-8",
  md: "h-12",
  lg: "h-16",
};
---

<a href="/" class={`inline-flex items-center group select-none ${className}`}>
  <div class={`${iconSizes[size]} w-auto flex items-center`}>
    <img src="/images/Final%20seelutions%20logo%20with%20tagline.png" alt="Seelutions Logo" fetchpriority={fetchpriority} class="h-full w-auto object-contain" />
  </div>
</a>
