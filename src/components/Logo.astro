---
interface Props {
  variant?: "dark" | "light";
  size?: "sm" | "md" | "lg";
  class?: string;
  tagline?: string;
  fetchpriority?: "high" | "low" | "auto";
}

const { variant = "dark", size = "md", class: className = "", tagline, fetchpriority = "auto" } = Astro.props;

const isLight = variant === "light";

const iconSizes = {
  sm: "h-8",
  md: "h-10 sm:h-12",
  lg: "h-14 sm:h-16",
};
---

<a href="/" class={`inline-flex items-center group select-none ${className}`}>
  <div class={`${iconSizes[size]} w-auto flex items-center`}>
    <img
      src="/images/seelutions%20Full%20Logo%20on%20White%20Background.png"
      alt="seelutions Logo — be seen. be chosen."
      fetchpriority={fetchpriority}
      class={`h-full w-auto object-contain transition-opacity group-hover:opacity-90 ${isLight ? "filter brightness-0 invert" : ""}`}
      width="343"
      height="84"
    />
  </div>
</a>
