---
interface Props {
  variant?: "dark" | "light";
  size?: "sm" | "md" | "lg";
  class?: string;
  tagline?: string;
  fetchpriority?: "high" | "low" | "auto";
}

const { variant = "dark", size = "md", class: className = "", tagline, fetchpriority = "auto" } = Astro.props;

const isLight = variant === "light";
const textColor = isLight ? "text-white" : "text-[#030303]";

const iconSizes = {
  sm: "h-10 w-10",
  md: "h-16 w-16",
  lg: "h-20 w-20",
};

const textSizes = {
  sm: "text-lg",
  md: "text-xl",
  lg: "text-2xl",
};
---

<a href="/" class={`inline-flex items-center gap-3 group select-none ${className}`}>
  <!-- New logo -->
  <div class={iconSizes[size]}>
    <img src="/images/Final%20seelutions%20logo%20with%20tagline.png" alt="Seelutions Logo" fetchpriority={fetchpriority} class="w-full h-full object-contain" />
  </div>
  <div class="flex flex-col">
    <span class={`font-bold tracking-tight ${textColor} ${textSizes[size]}`}>
      Seelutions
    </span>
    {tagline && <span class="text-[10px] font-medium text-neutral-500 uppercase tracking-widest -mt-0.5">{tagline}</span>}
  </div>
</a>
