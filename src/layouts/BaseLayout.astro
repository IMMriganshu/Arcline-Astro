---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ScrollToTop from "../components/ScrollToTop.astro";
import ContactModal from "../components/ContactModal.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Arcline — Architecture & Design Agency",
  description = "Distinguished architectural agency located in Canada, creating meaningful spaces that stand the test of time.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Google Font: Urbanist -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Urbanist:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,400&display=swap"
      rel="stylesheet"
    />

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "ArchitecturalFirm",
        "name": "Arcline Architecture",
        "description": "Distinguished architectural agency located in Canada creating meaningful spaces.",
        "foundingDate": "2010",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "567 Jac Spruce Crescent",
          "addressLocality": "Montreal",
          "addressRegion": "QC",
          "postalCode": "H1A 2K3",
          "addressCountry": "CA"
        },
        "telephone": "+1-555-345-6789",
        "email": "yourcompany@gmail.com"
      }
    </script>
  </head>
  <body class="min-h-screen flex flex-col justify-between selection:bg-black selection:text-white">
    <Header />

    <main class="flex-grow">
      <slot />
    </main>

    <Footer />
    <ScrollToTop />
    <ContactModal />

    <script>
      import { initAnimations } from "../scripts/animations";

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", () => {
          initAnimations();
        });
      } else {
        initAnimations();
      }
    </script>
  </body>
</html>
