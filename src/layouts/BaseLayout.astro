---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ScrollToTop from "../components/ScrollToTop.astro";
import ContactModal from "../components/ContactModal.astro";
import { getSiteConfig } from "../lib/cms";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const siteConfig = await getSiteConfig();

const {
  title,
  description,
  ogImage = siteConfig.ogImage || "/images/home-hero-image.webp",
} = Astro.props;

const pageTitle = title || siteConfig.title || siteConfig.name || "Arcline — Architecture & Design Agency";
const pageDescription = description || siteConfig.description || "Distinguished architectural agency located in Canada, creating meaningful spaces that stand the test of time.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/images/seelutions-favicon.png" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO Meta Tags -->
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Google Font: Urbanist (Non-render-blocking with display=swap) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Urbanist:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,400&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Urbanist:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,400&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Urbanist:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,400&display=swap"
      />
    </noscript>

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ArchitecturalFirm",
      "name": siteConfig.name || "Arcline Architecture",
      "description": pageDescription,
      "foundingDate": siteConfig.estYear || "2010",
      "telephone": siteConfig.phone || "+1-555-345-6789",
      "email": siteConfig.email || "yourcompany@gmail.com",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": siteConfig.address || "567 Jac Spruce Crescent",
        "addressLocality": "Montreal",
        "addressRegion": "QC",
        "postalCode": "H1A 2K3",
        "addressCountry": "CA"
      }
    })} />
  </head>
  <body class="min-h-screen flex flex-col justify-between selection:bg-black selection:text-white">
    <Header />

    <main class="flex-grow">
      <slot />
    </main>

    <Footer />
    <ScrollToTop />
    <ContactModal />

    <script>
      import { initAnimations } from "../scripts/animations";

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", () => {
          initAnimations();
        });
      } else {
        initAnimations();
      }
    </script>
  </body>
</html>
